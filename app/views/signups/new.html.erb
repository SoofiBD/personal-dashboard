<section class="auth-card kinetic-card" aria-labelledby="signup-title">
  <div class="auth-card-header">
    <div class="auth-brand-badge">
      <div class="brand-icon auth-icon-pulse">
        <%= finance_svg_icon("vault", class: "icon-brand") %>
      </div>
      <div class="brand-text">
        <span class="brand-title"><%= t("app.name", default: "Personal") %></span>
        <span class="brand-subtitle"><%= t("app.module", default: "Financial Hub") %></span>
      </div>
    </div>
    <div class="auth-title-block">
      <h1 id="signup-title"><%= t("auth.signup_title", default: "Hesap Oluştur") %></h1>
      <p><%= t("auth.signup_subtitle", default: "İlk yönetici hesabı için bilgileri girin. Bu hesap tüm ayarları yönetecek.") %></p>
    </div>
  </div>

  <%= form_with url: signup_path, method: :post, class: "auth-form" do |form| %>
    <div class="form-group auth-field-group">
      <%= form.label :name, t("auth.name_label", default: "İsim") %>
      <%= form.text_field :name, required: true, autocomplete: "name", placeholder: t("auth.name_placeholder", default: "Adınız"), class: "auth-input auth-input-plain" %>
    </div>

    <div class="form-group auth-field-group">
      <%= form.label :email, t("auth.email_label", default: "E-posta (İsteğe bağlı)") %>
      <%= form.email_field :email, autocomplete: "email", placeholder: t("auth.email_placeholder", default: "ornek@domain.com"), class: "auth-input auth-input-plain" %>
    </div>

    <div class="form-group auth-field-group">
      <%= form.label :password, t("auth.password_label", default: "Parola") %>
      <div class="auth-input-wrapper">
        <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", placeholder: t("auth.password_placeholder", default: "••••••••••••••••"), class: "auth-input auth-password-input" %>
        <button type="button" class="auth-password-toggle" id="toggle-password-btn" aria-label="<%= t('auth.toggle_password', default: 'Parolayı göster veya gizle') %>" title="<%= t('auth.toggle_password', default: 'Parolayı göster veya gizle') %>" tabindex="-1">
          <svg class="icon-eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <svg class="icon-eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
            <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
            <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
            <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
            <line x1="2" x2="22" y1="2" y2="22"/>
          </svg>
        </button>
      </div>
      <small><%= t("auth.password_hint", default: "En az 16 karakter") %></small>
    </div>

    <div class="form-group auth-field-group">
      <%= form.label :password_confirmation, t("auth.password_confirmation_label", default: "Parola Tekrarı") %>
      <div class="auth-input-wrapper">
        <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", placeholder: t("auth.password_placeholder", default: "••••••••••••••••"), class: "auth-input auth-password-input" %>
        <button type="button" class="auth-password-toggle" id="toggle-password-confirm-btn" aria-label="<%= t('auth.toggle_password', default: 'Parolayı göster veya gizle') %>" title="<%= t('auth.toggle_password', default: 'Parolayı göster veya gizle') %>" tabindex="-1">
          <svg class="icon-eye-show" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <svg class="icon-eye-hide" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
            <path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/>
            <path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/>
            <path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>
            <line x1="2" x2="22" y1="2" y2="22"/>
          </svg>
        </button>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group auth-field-group">
        <%= form.label :currency, t("auth.currency_label", default: "Para Birimi") %>
        <%= form.select :currency, [["TRY", "TRY (₺)"], ["USD", "USD ($)"], ["EUR", "EUR (€)"], ["GBP", "GBP (£)"]], {}, class: "auth-input auth-input-plain" %>
      </div>

      <div class="form-group auth-field-group">
        <%= form.label :locale, t("auth.locale_label", default: "Dil") %>
        <%= form.select :locale, [["tr", "Türkçe"], ["en", "English"]], {}, class: "auth-input auth-input-plain" %>
      </div>
    </div>

    <div class="auth-actions">
      <%= form.submit t("auth.signup_submit", default: "Hesabı Oluştur"), class: "button button-primary auth-submit-btn" %>
    </div>
  <% end %>

  <div class="auth-footer">
    <%= link_to t("auth.signin_link", default: "Zaten hesabınız var mı? Giriş yapın"), new_session_path, class: "auth-footer-link" %>
  </div>
</section>