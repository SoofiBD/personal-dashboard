<header class="page-header"><div><p class="eyebrow">HESAP & GÜVENLİK</p><h1>Profil Tercihleri</h1><p class="page-subtitle">Kişisel görünüm, bölge ve giriş güvenliği ayarlarınızı yönetin.</p></div></header>

<div class="access-settings-grid">
  <section class="panel">
    <div class="panel-header"><div><h2>Kişisel tercihler</h2><p>Bu tercihler yalnızca hesabınıza uygulanır.</p></div></div>
    <%= form_with model: @user, url: profile_path, method: :patch do |form| %>
      <% if @user.errors.any? %><div class="form-errors" role="alert" tabindex="-1"><%= @user.errors.full_messages.to_sentence %></div><% end %>
      <div class="profile-form-grid">
        <div class="form-group"><%= form.label :name, "Görünen ad" %><%= form.text_field :name, required: true %></div>
        <div class="form-group"><%= form.label :email, "E-posta" %><%= form.email_field :email, autocomplete: "email" %></div>
        <div class="form-group"><%= form.label :currency, "Para birimi" %><%= form.text_field :currency, required: true, maxlength: 3, style: "text-transform:uppercase" %></div>
        <div class="form-group"><%= form.label :locale, "Dil" %><%= form.select :locale, [["Türkçe", "tr"], ["English", "en"]] %></div>
        <div class="form-group"><%= form.label :time_zone, "Saat dilimi" %><%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.all, default: @user.time_zone %></div>
        <div class="form-group"><%= form.label :theme_preference, "Tema" %><%= form.select :theme_preference, [["Sistem", "system"], ["Koyu", "dark"], ["Açık", "light"]] %></div>
      </div>
      <div class="form-actions"><%= form.submit "Tercihleri Kaydet", class: "button button-primary" %></div>
    <% end %>
  </section>

  <section class="panel security-panel">
    <div class="panel-header"><div><h2>İki adımlı doğrulama</h2><p>Parolanıza ek olarak doğrulama uygulaması kodu istenir.</p></div></div>
    <p class="security-status <%= @user.mfa_enabled? ? "is-enabled" : "" %>"><%= @user.mfa_enabled? ? "Etkin" : "Kapalı" %></p>
    <% if @user.mfa_enabled? %>
      <%= button_to "MFA’yı Kapat", mfa_path, method: :delete, class: "button button-secondary", data: {turbo_confirm: "İki adımlı doğrulamayı kapatmak istediğinizden emin misiniz?"} %>
    <% else %>
      <%= link_to "MFA’yı Kur", mfa_path, class: "button button-primary" %>
    <% end %>
  </section>
</div>
