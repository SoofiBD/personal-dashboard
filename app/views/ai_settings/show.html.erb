<header class="page-header">
  <div>
    <p class="eyebrow">YAPAY ZEKÂ</p>
    <h1>Sağlayıcı ve model</h1>
    <p class="page-subtitle">Asistanın kullanacağı Gemini modelini hesabın için yönetin.</p>
  </div>
</header>

<div class="ai-settings-grid">
  <section class="panel">
    <div class="panel-header"><div><h2>Gemini model tercihi</h2><p>Bu tercih yalnızca hesabına uygulanır. Model adı doğrudan girilir.</p></div></div>
    <%= form_with model: @user, url: ai_settings_path, method: :patch do |form| %>
      <% if @user.errors.any? %><div class="form-errors" role="alert" tabindex="-1"><%= @user.errors.full_messages.to_sentence %></div><% end %>
      <div class="form-group">
        <%= form.label :ai_model, "Kullanılacak model" %>
        <%= form.text_field :ai_model, autocomplete: "off", placeholder: "gemini-3.6-flash" %>
        <small>Boş bırakırsanız <code>gemini-3.6-flash</code> kullanılır.</small>
      </div>
      <div class="form-actions"><%= form.submit "Model tercihini kaydet", class: "button button-primary" %></div>
    <% end %>
  </section>

  <aside class="panel ai-connection-panel" aria-labelledby="gemini-status-title">
    <div class="panel-header"><div><h2 id="gemini-status-title">Gemini yapılandırması</h2><p>Anahtar yalnızca sunucu ortamında tutulur ve hiçbir zaman tarayıcıya gönderilmez.</p></div></div>
    <p class="security-status <%= "is-enabled" if @gemini_status.available? %>" role="status" aria-atomic="true"><%= @gemini_status.message %></p>
    <% if @gemini_status.code == :missing %>
      <p class="ai-status-note"><code>GEMINI_API_KEY</code> değişkenini uygulamanın ortam dosyasına ekleyin ve uygulamayı yeniden başlatın.</p>
    <% end %>
  </aside>
</div>
