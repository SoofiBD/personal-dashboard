<section class="auth-card kinetic-card" aria-labelledby="login-title">
  <div class="auth-card-header">
    <div class="auth-brand-badge">
      <div class="brand-icon auth-icon-pulse">
        <%= finance_svg_icon("vault", class: "icon-brand") %>
      </div>
      <div class="brand-text">
        <span class="brand-title">Personal</span>
        <span class="brand-subtitle">Financial Hub</span>
      </div>
    </div>
    <div class="auth-title-block">
      <h1 id="login-title">Yönetici Girişi</h1>
      <p>Finansal egemenlik panelinize erişmek için parolanızı girin.</p>
    </div>
  </div>

  <%= form_with url: session_path, method: :post, class: "auth-form" do |form| %>
    <div class="form-group auth-field-group">
      <%= form.label :identifier, "E-posta veya kullanıcı adı" %>
      <%= form.text_field :identifier, autocomplete: "username", placeholder: "owner@example.com", class: "auth-input auth-input-plain" %>
    </div>
    <div class="form-group auth-field-group">
      <%= form.label :password, "Yönetici Parolası" %>
      <div class="auth-input-wrapper">
        <svg class="auth-input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <%= form.password_field :password, required: true, autofocus: true, autocomplete: "current-password", placeholder: "••••••••••••••••", class: "auth-input" %>
      </div>
    </div>

    <div class="auth-actions">
      <%= form.submit "Kasaya Giriş Yap", class: "button button-primary auth-submit-btn" %>
    </div>
  <% end %>

</section>
