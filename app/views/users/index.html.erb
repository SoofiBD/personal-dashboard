<header class="page-header"><div><p class="eyebrow"><%= t("users_mgmt.eyebrow", default: "ERİŞİM YÖNETİMİ") %></p><h1><%= t("users_mgmt.title", default: "Kullanıcılar") %></h1><p class="page-subtitle"><%= t("users_mgmt.subtitle", default: "Kullanıcı rollerini ve kişisel çalışma alanlarını yönetin.") %></p></div><%= link_to t("users_mgmt.add_user", default: "Kullanıcı Ekle"), new_user_path, class: "button button-primary" %></header>
<section class="panel"><div class="access-user-list"><% @users.each do |user| %><article class="access-user-row"><div><h2><%= user.name %></h2><p><%= user.locale.upcase %> · <%= user.currency %> · MFA: <%= user.mfa_enabled? ? t("profile.mfa_enabled", default: "Etkin") : t("profile.mfa_disabled", default: "Kapalı") %></p></div><div class="access-user-actions"><span class="badge-pill badge-pill-subtle"><%= t("users_mgmt.role_#{user.role}", default: user.role.humanize) %></span><%= link_to t("app.common.edit", default: "Düzenle"), edit_user_path(user), class: "button button-secondary button-sm" %></div></article><% end %></div></section>
