<header class="page-header"><div><p class="eyebrow">ERİŞİM YÖNETİMİ</p><h1>Kullanıcılar</h1><p class="page-subtitle">Kullanıcı rollerini ve kişisel çalışma alanlarını yönetin.</p></div><%= link_to "Kullanıcı Ekle", new_user_path, class: "button button-primary" %></header>
<section class="panel"><div class="access-user-list"><% @users.each do |user| %><article class="access-user-row"><div><h2><%= user.name %></h2><p><%= user.locale.upcase %> · <%= user.currency %> · MFA: <%= user.mfa_enabled? ? "Etkin" : "Kapalı" %></p></div><div class="access-user-actions"><span class="badge-pill badge-pill-subtle"><%= user.role %></span><%= link_to "Düzenle", edit_user_path(user), class: "button button-secondary button-sm" %></div></article><% end %></div></section>
