<%= form_with model: @user do |form| %>
  <% if @user.errors.any? %><div class="form-errors" role="alert" tabindex="-1"><%= @user.errors.full_messages.to_sentence %></div><% end %>
  <div class="profile-form-grid">
    <div class="form-group"><%= form.label :name, t("users_mgmt.name", default: "Ad") %><%= form.text_field :name, required: true %></div>
    <div class="form-group"><%= form.label :email, t("users_mgmt.email", default: "E-posta") %><%= form.email_field :email, required: true, autocomplete: "email" %></div>
    <div class="form-group"><%= form.label :role, t("users_mgmt.role", default: "Rol") %><%= form.select :role, [[t("users_mgmt.role_owner_desc", default: "Sahip — tüm ayarlar"), "owner"], [t("users_mgmt.role_editor_desc", default: "Düzenleyici — finans verilerini yönetir"), "editor"], [t("users_mgmt.role_viewer_desc", default: "Görüntüleyici — salt okunur"), "viewer"]] %></div>
    <div class="form-group"><%= form.label :currency, t("profile.currency", default: "Para birimi") %><%= form.text_field :currency, required: true, maxlength: 3 %></div>
    <div class="form-group"><%= form.label :locale, t("profile.locale", default: "Dil") %><%= form.select :locale, [["Türkçe", "tr"], ["English", "en"]] %></div>
    <div class="form-group"><%= form.label :time_zone, t("profile.time_zone", default: "Saat dilimi") %><%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.all, default: @user.time_zone %></div>
    <div class="form-group"><%= form.label :password, @user.persisted? ? t("users_mgmt.password_new", default: "Yeni parola (isteğe bağlı)") : t("users_mgmt.password_temp", default: "Geçici parola") %><%= form.password_field :password, autocomplete: "new-password", required: !@user.persisted? %></div>
    <div class="form-group"><%= form.label :password_confirmation, t("users_mgmt.password_confirmation", default: "Parola tekrarı") %><%= form.password_field :password_confirmation, autocomplete: "new-password", required: !@user.persisted? %></div>
  </div>
  <div class="form-actions"><%= form.submit t("app.common.save", default: "Kaydet"), class: "button button-primary" %><%= link_to t("app.common.cancel", default: "İptal"), users_path, class: "button button-secondary" %></div>
<% end %>
