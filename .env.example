# Copy to .env.local and customize for your machine.
DASHBOARD_OWNER_NAME=Kişisel Dashboard
# DASHBOARD_AUTH_PASSWORD is accepted only by the credential provisioning task.
DASHBOARD_CURRENCY=TRY
DASHBOARD_TIME_ZONE=Europe/Istanbul
POSTGRES_DB=personal_dashboard_development
TEST_POSTGRES_DB=personal_dashboard_test
POSTGRES_USER=personal_dashboard
POSTGRES_PASSWORD=
JAN_API_BASE_URL=http://host.docker.internal:1337
