<header class="page-header"><div><p class="eyebrow">CSV İÇE AKTARMA · 3 / 3</p><h1>İçe Aktarmayı Kontrol Et</h1><p class="page-subtitle">Hazır satırlar eklenecek; yinelenenler atlanacak, hatalı satırlar eklenmeyecek.</p></div></header>
<section class="panel yearly-table-panel import-preview"><div class="yearly-table-wrapper"><table class="yearly-table"><thead><tr><th>Satır</th><th>Tarih</th><th>Tür</th><th>Tutar</th><th>Kategori</th><th>Not</th><th>Durum</th></tr></thead><tbody><% @preview_rows.each do |row| %><tr><td><%= row["line"] %></td><td><%= row["date"] %></td><td><%= row["kind"] %></td><td><%= row["amount"] %></td><td><%= row["category"] %></td><td><%= row["note"] %></td><td><span class="import-status is-<%= row["status"] %>"><%= row["error"].presence || (row["status"] == "ready" ? "Hazır" : "Yinelenen") %></span></td></tr><% end %></tbody></table></div>
  <div class="form-actions"><%= button_to "İçe Aktarmayı Onayla", confirm_import_finance_transactions_path(import_id: @transaction_import.id), method: :post, class: "button button-primary" %><%= link_to "Eşlemeye Dön", import_finance_transactions_path, class: "button button-secondary" %></div>
</section>
