<header class="page-header"><div><p class="eyebrow"><%= t("import.preview_eyebrow") %></p><h1><%= t("import.preview_title") %></h1><p class="page-subtitle"><%= t("import.preview_subtitle") %></p></div></header>
<section class="panel yearly-table-panel import-preview"><div class="yearly-table-wrapper"><table class="yearly-table"><thead><tr><th><%= t("import.row") %></th><th><%= t("import.field_date") %></th><th><%= t("import.field_type") %></th><th><%= t("import.field_amount") %></th><th><%= t("import.field_category") %></th><th><%= t("import.field_note") %></th><th><%= t("import.status") %></th></tr></thead><tbody><% @preview_rows.each do |row| %><tr><td><%= row["line"] %></td><td><%= row["date"] %></td><td><%= row["kind"] %></td><td><%= row["amount"] %></td><td><%= row["category"] %></td><td><%= row["note"] %></td><td><span class="import-status is-<%= row["status"] %>"><%= row["error"].presence || (row["status"] == "ready" ? t("import.status_ready") : t("import.status_duplicate")) %></span></td></tr><% end %></tbody></table></div>
  <div class="form-actions"><%= button_to t("import.confirm_import"), confirm_import_finance_transactions_path(import_id: @transaction_import.id), method: :post, class: "button button-primary" %><%= link_to t("import.back_to_mapping"), import_finance_transactions_path, class: "button button-secondary" %></div>
</section>
