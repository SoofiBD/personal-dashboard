<header class="page-header"><div><p class="eyebrow"><%= t("import.map_eyebrow") %></p><h1><%= t("import.map_title") %></h1><p class="page-subtitle"><%= t("import.map_subtitle") %></p></div></header>
<section class="panel form-panel import-panel">
  <%= form_with url: preview_import_finance_transactions_path do |form| %>
    <%= hidden_field_tag :import_id, @transaction_import.id %><%= render "personal_finance/shared/errors", record: @transaction_import %>
    <% [["date", t("import.field_date"), true], ["amount", t("import.field_amount"), true], ["type", t("import.field_type"), false], ["category", t("import.field_category"), false], ["note", t("import.field_note"), false]].each do |field, label, required| %>
      <div class="form-group"><%= label_tag "column_mapping_#{field}", "#{label}#{required ? " *" : " #{t('import.optional')}"}" %><%= select_tag "column_mapping[#{field}]", options_for_select([[t("import.select_column"), ""]] + @headers.map { |header| [header, header] }, @transaction_import.column_mapping[field]), id: "column_mapping_#{field}", required: required %></div>
    <% end %>
    <div class="form-actions"><%= form.submit t("import.show_preview"), class: "button button-primary" %><%= link_to t("import.upload_different"), import_finance_transactions_path, class: "button button-secondary" %></div>
  <% end %>
</section>
