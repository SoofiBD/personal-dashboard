<header class="page-header"><div><p class="eyebrow"><%= t("import.summary_eyebrow") %></p><h1><%= t("import.summary_title") %></h1><p class="page-subtitle"><%= t("import.summary_subtitle") %></p></div></header>
<section class="panel import-summary"><div><strong><%= @transaction_import.created_count %></strong><span><%= t("import.created") %></span></div><div><strong><%= @transaction_import.skipped_count %></strong><span><%= t("import.skipped_duplicates") %></span></div><div><strong><%= @transaction_import.error_count %></strong><span><%= t("import.errors") %></span></div></section>
<div class="form-actions"><%= link_to t("import.back_to_transactions"), finance_transactions_path, class: "button button-primary" %><%= link_to t("import.import_another"), import_finance_transactions_path, class: "button button-secondary" %></div>
