<%= form_with model: @transaction, scope: :transaction, url: @transaction.persisted? ? finance_transaction_path(@transaction) : finance_transactions_path do |form| %>
  <%= render "personal_finance/shared/errors", record: @transaction %>

  <div class="form-group">
    <%= form.label :kind, t("transactions.kind", default: "İşlem Türü") %>
    <%= form.select :kind, [[t("transactions.kinds.expense", default: "Gider"), "expense"], [t("transactions.kinds.income", default: "Gelir"), "income"], [t("transactions.kinds.transfer", default: "Transfer"), "transfer"]] %>
  </div>

  <div class="form-group goal-transfer-field">
    <%= label_tag "transaction_savings_goal_id", t("transactions.savings_goal", default: "Tasarruf Hedefine Bağla") %>
    <%= select_tag "transaction[savings_goal_id]", options_from_collection_for_select(PersonalFinance::SavingsGoal.where(user_id: current_panel_user.id, status: "active").order(:name), :id, :name), include_blank: t("transactions.no_savings_goal", default: "Hedefe bağlama"), id: "transaction_savings_goal_id" %>
    <p class="field-hint"><%= t("transactions.savings_goal_hint", default: "Yalnızca tasarruf hesabına yapılan transferlerde kullanılabilir; tutar hedef katkısı olarak kaydedilir.") %></p>
  </div>

  <div class="form-group">
    <%= form.label :amount, t("transactions.amount", default: "Tutar") %>
    <%= form.number_field :amount, step: 0.01, min: 0.01, placeholder: "0.00", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :occurred_on, t("transactions.occurred_on", default: "Tarih") %>
    <%= form.date_field :occurred_on, required: true %>
  </div>

  <div class="form-group">
    <%= form.label :financial_account_id, t("transactions.account", default: "Hesap") %>
    <%= form.collection_select :financial_account_id, PersonalFinance::Account.where(user_id: current_panel_user.id, is_active: true), :id, :name %>
  </div>

  <div class="form-group">
    <%= form.label :category_id, t("transactions.category", default: "Kategori") %>
    <%= form.collection_select :category_id, PersonalFinance::Category.where(user_id: current_panel_user.id), :id, :name, {include_blank: t("app.common.uncategorized", default: "Kategorisiz")}, data: {category_suggestion_target: "select"} %>
  </div>

  <div class="form-group">
    <%= form.label :note, t("transactions.note", default: "Açıklama / Not (İsteğe bağlı)") %>
    <%= form.text_field :note, maxlength: 500, placeholder: t("transactions.note_placeholder", default: "Market alışverişi, fatura vb."), data: {category_suggestion_target: "note", category_suggestion_url: category_suggestion_finance_transactions_path} %>
  </div>

  <div class="form-group tag-input-group">
    <%= label_tag "transaction_tag_names", t("transactions.tags", default: "Etiketler") %>
    <%= text_field_tag "transaction[tag_names]", @transaction.tags.order(:name).pluck(:name).join(", "), id: "transaction_tag_names", list: "transaction-tag-suggestions", maxlength: 300, placeholder: t("transactions.tags_placeholder", default: "Örn: tatil, iş, düğün") %>
    <datalist id="transaction-tag-suggestions"><% PersonalFinance::Tag.where(user_id: current_panel_user.id).order(:name).each do |tag| %><option value="<%= tag.name %>"><% end %></datalist>
    <p class="field-hint"><%= t("transactions.tags_hint", default: "Birden çok etiketi virgülle ayırın. Mevcut etiketler yazarken önerilir.") %></p>
  </div>

  <% if @transaction.persisted? && @transaction.recurring_rule.present? %>
    <div class="recurrence-callout">
      <%= finance_svg_icon("recurring", class: "icon-sm") %>
      <span><%= t("transactions.recurrence.edit_hint", default: "Bu işlem bir tekrar eden plana bağlıdır. Gelecek işlemleri değiştirmek için planı yönetin.") %></span>
      <%= link_to t("recurring_rules.manage", default: "Planı Yönet"), edit_finance_recurring_rule_path(@transaction.recurring_rule), class: "text-link" %>
    </div>
  <% elsif !@transaction.persisted? %>
    <fieldset class="recurrence-fields">
      <legend><%= t("transactions.recurrence.legend", default: "Tekrarlama") %></legend>
      <label class="recurrence-toggle">
        <%= form.check_box :is_recurring %>
        <span><%= t("transactions.recurrence.enable", default: "Bu işlemi tekrarlayan olarak kaydet") %></span>
      </label>
      <p class="field-hint"><%= t("transactions.recurrence.hint", default: "İlk işlem seçtiğiniz tarihte kaydedilir; sonraki işlemler planınıza göre otomatik eklenir.") %></p>
      <div class="recurrence-grid">
        <div class="form-group">
          <%= label_tag "transaction_recurrence_interval", t("transactions.recurrence.interval", default: "Tekrarlama sıklığı") %>
          <%= select_tag "transaction[recurrence_interval]", options_for_select([[t("transactions.recurrence.weekly", default: "Her hafta"), "weekly"], [t("transactions.recurrence.biweekly", default: "İki haftada bir"), "biweekly"], [t("transactions.recurrence.monthly", default: "Her ay"), "monthly"], [t("transactions.recurrence.yearly", default: "Her yıl"), "yearly"]], @transaction.recurrence_interval || "monthly"), id: "transaction_recurrence_interval" %>
        </div>
        <div class="form-group">
          <%= label_tag "transaction_recurrence_end_date", t("transactions.recurrence.end_date", default: "Bitiş tarihi (isteğe bağlı)") %>
          <%= date_field_tag "transaction[recurrence_end_date]", @transaction.recurrence_end_date, id: "transaction_recurrence_end_date" %>
        </div>
        <div class="form-group">
          <%= label_tag "transaction_recurrence_count", t("transactions.recurrence.count", default: "Toplam işlem sayısı (isteğe bağlı)") %>
          <%= number_field_tag "transaction[recurrence_count]", @transaction.recurrence_count, min: 1, step: 1, id: "transaction_recurrence_count" %>
        </div>
      </div>
    </fieldset>
  <% end %>

  <div class="form-actions">
    <%= form.submit @transaction.persisted? ? t("transactions.update", default: "İşlemi Güncelle") : t("transactions.save", default: "İşlemi Kaydet"), class: "button button-primary" %>
    <%= link_to t("app.common.cancel", default: "İptal"), finance_transactions_path, class: "button button-secondary" %>
  </div>
<% end %>
