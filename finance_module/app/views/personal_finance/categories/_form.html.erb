<%= form_with model: @category, url: @category.persisted? ? finance_category_path(@category) : finance_categories_path do |form| %><%= render "personal_finance/shared/errors", record: @category %><%= form.label :name, "Category name" %><%= form.text_field :name, maxlength: 80 %><%= form.label :kind, "Type" %><%= form.select :kind, PersonalFinance::Category.kinds.keys.map { |kind| [kind.humanize, kind] } %><%= form.label :color, "Color" %><%= form.color_field :color %><%= form.submit "Save category", class: "button button-primary" %><% end %>
