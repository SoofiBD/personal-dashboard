<%= form_with model: @category, scope: :category, url: @category.persisted? ? finance_category_path(@category) : finance_categories_path do |form| %>
  <%= render "personal_finance/shared/errors", record: @category %>

  <div class="form-group">
    <%= form.label :name, "Kategori Adı" %>
    <%= form.text_field :name, maxlength: 80, placeholder: "Örn: Market, Kira, Maaş, Ulaşım", required: true %>
  </div>

  <div class="form-group">
    <%= form.label :kind, "Kategori Türü" %>
    <%= form.select :kind, [["Gider (Expense)", "expense"], ["Gelir (Income)", "income"], ["Transfer", "transfer"]] %>
  </div>

  <div class="form-group">
    <%= form.label :color, "Renk Rozeti" %>
    <%= form.color_field :color, value: @category.color.presence || "#3B82F6" %>
  </div>

  <div class="form-actions">
    <%= form.submit @category.persisted? ? "Kategoriyi Güncelle" : "Kategoriyi Kaydet", class: "button button-primary" %>
    <%= link_to "İptal", finance_categories_path, class: "button button-secondary" %>
  </div>
<% end %>

