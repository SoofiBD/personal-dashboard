<header class="page-header">
  <div>
    <p class="eyebrow"><%= t("categories.eyebrow", default: "ORGANİZASYON") %></p>
    <h1><%= t("categories.title", default: "Kategoriler") %></h1>
    <p class="page-subtitle"><%= t("categories.subtitle", default: "Harcamalarınızı ve gelirlerinizi kategorize ederek düzenli tutun.") %></p>
  </div>
  <%= link_to new_finance_category_path, class: "button button-primary" do %>
    <%= finance_svg_icon("plus", class: "icon-sm") %>
    <span><%= t("categories.new_title", default: "Yeni Kategori Ekle") %></span>
  <% end %>
</header>

<section class="panel">
  <% if @categories.any? %>
    <div class="finance-list">
      <% @categories.each do |category| %>
        <article class="finance-item-row">
          <div class="transaction-left">
            <span style="display: inline-block; width: 14px; height: 14px; border-radius: 50%; background-color: <%= category.color.presence || '#3B82F6' %>; box-shadow: 0 0 8px <%= category.color.presence || '#3B82F6' %>80;"></span>
            <div class="transaction-meta">
              <span class="transaction-category"><%= category.name %></span>
              <span class="transaction-submeta">
                <span class="badge-pill badge-pill-subtle">
                  <%= t("transactions.kinds.#{category.kind}", default: category.kind.humanize) %>
                </span>
                <% if category.parent %>
                  <span><%= t("categories.parent_category", default: "Üst Kategori") %>: <%= category.parent.name %></span>
                <% end %>
              </span>
            </div>
          </div>

          <div class="transaction-actions">
            <%= link_to edit_finance_category_path(category), class: "action-btn", title: t("app.common.edit", default: "Düzenle") do %>
              <%= finance_svg_icon("edit") %>
            <% end %>
            <%= button_to finance_category_path(category), method: :delete, data: { turbo_confirm: t("app.common.confirm_delete", default: "Bu kategoriyi silmek istediğinizden emin misiniz?") }, class: "action-btn delete", title: t("app.common.delete", default: "Sil"), form: { style: "display: inline;" } do %>
              <%= finance_svg_icon("trash") %>
            <% end %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <p><%= t("categories.empty_state", default: t("app.common.empty_state", default: "Kayıtlı bir kategori bulunmuyor.")) %></p>
      <%= link_to t("categories.add_first", default: t("categories.new_title", default: "İlk Kategoriyi Ekle")), new_finance_category_path, class: "button button-secondary button-sm" %>
    </div>
  <% end %>
</section>


