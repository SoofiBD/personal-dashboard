<%= form_with model: @savings_goal, url: @savings_goal.persisted? ? finance_savings_goal_path(@savings_goal) : finance_savings_goals_path do |form| %><%= render "personal_finance/shared/errors", record: @savings_goal %><%= form.label :name, "Goal name" %><%= form.text_field :name, maxlength: 100 %><%= form.label :target_amount, "Target amount" %><%= form.number_field :target_amount, step: 0.01, min: 0.01 %><%= form.label :monthly_contribution, "Monthly contribution" %><%= form.number_field :monthly_contribution, step: 0.01, min: 0 %><%= form.label :target_date, "Target date" %><%= form.date_field :target_date %><%= form.submit "Save goal", class: "button button-primary" %><% end %>
