<div class="finance-list">
  <% if savings_goals.any? %>
    <% savings_goals.each do |goal| %>
      <% percent = goal.target_amount.positive? ? [(goal.saved_amount / goal.target_amount * 100).round, 100].min : 0 %>
      <article class="finance-item-row" style="flex-direction: column; align-items: stretch; gap: 0.85rem;">
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div style="display: flex; align-items: center; gap: 0.6rem;">
            <span class="transaction-category"><%= goal.name %></span>
            <span class="badge-pill <%= goal.status == 'completed' ? 'badge-status-comfortable' : (goal.status == 'active' ? 'badge-pill-subtle' : 'badge-status-plan') %>">
              <%= t("savings_goals.statuses.#{goal.status}", default: goal.status.humanize) %>
            </span>
          </div>

          <div class="transaction-actions">
            <%= link_to finance_savings_goal_path(goal), class: "action-btn", title: t("savings_goals.details", default: "Detaylar") do %>
              <%= finance_svg_icon("chart") %>
            <% end %>
            <%= link_to edit_finance_savings_goal_path(goal), class: "action-btn", title: t("app.common.edit", default: "Düzenle") do %>
              <%= finance_svg_icon("edit") %>
            <% end %>
            <%= button_to finance_savings_goal_path(goal), method: :delete, data: { turbo_confirm: t("app.common.confirm_delete", default: "Bu hedefi silmek istediğinizden emin misiniz?") }, class: "action-btn delete", title: t("app.common.delete", default: "Sil"), form: { style: "display: inline;" } do %>
              <%= finance_svg_icon("trash") %>
            <% end %>
          </div>
        </div>

        <div>
          <div style="display: flex; justify-content: space-between; margin-bottom: 0.4rem; font-size: 0.88rem;">
            <span style="font-weight: 700; color: var(--text-main); font-variant-numeric: tabular-nums;">
              <%= dashboard_currency goal.saved_amount %> <span style="color: var(--text-muted); font-weight: normal;">/ <%= dashboard_currency goal.target_amount %></span>
            </span>
            <span style="font-weight: 700; color: var(--accent);">%<%= percent %></span>
          </div>
          <div class="progress-track" aria-label="<%= t('savings_goals.progress_aria_label', percent: percent, default: "Hedef tamamlama: %#{percent}") %>">
            <span class="progress-fill" style="width: <%= percent %>%"></span>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--text-muted);">
          <span><%= t("savings_goals.monthly_contrib_label", default: "Aylık Katkı:") %> <strong><%= dashboard_currency goal.monthly_contribution %></strong></span>
          <span><%= goal.estimated_months ? t("savings_goals.estimated_time", months: goal.estimated_months, default: "Tahmini süre: ~#{goal.estimated_months} ay") : t("savings_goals.no_target_date", default: "Hedef tarihi belirlenmedi") %></span>
        </div>
      </article>
    <% end %>
  <% else %>
    <div class="empty-state">
      <p><%= t("savings_goals.empty_state", default: t("app.common.empty_state", default: "Kayıtlı bir tasarruf hedefi bulunmuyor.")) %></p>
      <%= link_to t("savings_goals.new_title", default: "Yeni Hedef Ekle"), new_finance_savings_goal_path, class: "button button-secondary button-sm" %>
    </div>
  <% end %>
</div>

