<header class="page-header"><div><p class="eyebrow"><%= t("savings_goals.eyebrow", default: "FİNANSAL PLANLAMA") %></p><h1><%= @savings_goal.name %></h1><p class="page-subtitle"><%= t("savings_goals.detail_subtitle", default: "Hedef katkılarını ve bağlantılı tasarruf transferlerini inceleyin.") %></p></div><%= link_to t("savings_goals.back", default: "Hedeflere Dön"), finance_savings_goals_path, class: "button button-secondary" %></header>

<section class="goal-detail-grid"><article class="panel"><div class="panel-header"><div><h2><%= t("savings_goals.add_contribution", default: "Katkı Ekle") %></h2><p><%= t("savings_goals.add_contribution_note", default: "Mevcut bir tasarruf transferini seçebilir veya bağımsız katkı ekleyebilirsiniz.") %></p></div></div><%= form_with model: @contribution, scope: :goal_contribution, url: finance_savings_goal_goal_contributions_path(@savings_goal) do |form| %><div class="form-group"><%= form.label :transaction_id, t("savings_goals.linked_transfer", default: "Bağlantılı tasarruf transferi") %><%= form.select :transaction_id, options_from_collection_for_select(@eligible_transfers, :id, ->(transaction) { "#{l(transaction.occurred_on)} · #{dashboard_currency(transaction.amount)} · #{transaction.account.name}" }), include_blank: t("savings_goals.no_linked_transfer", default: "Transfer bağlama") %></div><div class="form-group"><%= form.label :amount, t("savings_goals.contribution_amount", default: "Katkı tutarı") %><%= form.number_field :amount, step: 0.01, min: 0.01, required: true %></div><div class="form-group"><%= form.label :contributed_on, t("savings_goals.contributed_on", default: "Tarih") %><%= form.date_field :contributed_on, required: true %></div><div class="form-group"><%= form.label :note, t("transactions.note", default: "Not") %><%= form.text_field :note, maxlength: 500 %></div><div class="form-actions"><%= form.submit t("savings_goals.add_contribution", default: "Katkı Ekle"), class: "button button-primary" %></div><% end %></article>
<article class="panel"><div class="panel-header"><div><h2><%= t("savings_goals.contribution_history", default: "Katkı Geçmişi") %></h2><p><%= t("savings_goals.contribution_history_note", default: "Bağlantılı transferler gider olarak sayılmaz.") %></p></div></div><% if @contributions.any? %><div class="goal-contribution-list"><% @contributions.each do |contribution| %><div class="goal-contribution-row"><div><strong><%= dashboard_currency contribution.amount %></strong><span><%= l(contribution.contributed_on) %></span><% if contribution.linked_transaction %><span class="recurring-badge"><%= finance_svg_icon("recurring", class: "icon-xs") %><%= t("savings_goals.linked_transfer", default: "Bağlantılı transfer") %> · <%= contribution.linked_transaction.account.name %></span><% end %><% if contribution.note.present? %><span class="goal-contribution-note"><%= contribution.note %></span><% end %></div></div><% end %></div><% else %><div class="empty-state"><p><%= t("savings_goals.no_contributions", default: "Henüz katkı kaydı bulunmuyor.") %></p></div><% end %></article></section>
