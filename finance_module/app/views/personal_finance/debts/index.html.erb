<header class="page-header"><div><p class="eyebrow"><%= t("debts.eyebrow") %></p><h1><%= t("debts.title") %></h1><p class="page-subtitle"><%= t("debts.subtitle") %></p></div><%= link_to t("debts.add"), new_finance_debt_path, class: "button button-primary" %></header><section class="finance-cards"><article class="metric-card"><span class="metric-label"><%= t("debts.total_debt_load") %></span><strong class="value-negative"><%= dashboard_currency @total_debt %></strong></article><article class="metric-card"><span class="metric-label"><%= t("debts.upcoming_payment") %></span><strong><%= @upcoming.size %></strong><span class="metric-note"><%= t("debts.next_30_days") %></span></article></section><section class="panel"><div class="panel-header"><div><h2><%= t("debts.payment_schedule_title") %></h2><p><%= t("debts.payment_schedule_desc") %></p></div></div><% if @debts.any? %><div class="subscription-list"><% @debts.each do |debt| %><article class="subscription-row"><div><div class="subscription-title"><h3><%= debt.name %></h3><% if debt.next_payment_on && debt.next_payment_on <= Date.current + 30.days %><span class="template-badge custom"><%= t("debts.approaching") %></span><% end %></div><p><%= t("debts.remaining_installments_label") %>: <%= debt.remaining_installments %> · <%= t("debts.estimated_payoff") %> <%= debt.payoff_date ? l(debt.payoff_date) : "—" %></p></div><div class="subscription-actions"><strong class="value-negative"><%= dashboard_currency debt.remaining_amount %></strong><%= button_to t("debts.record_payment"), pay_finance_debt_path(debt), params: {amount: debt.monthly_payment, paid_on: Date.current}, class: "button button-primary button-sm" if debt.active? %><%= link_to t("app.common.edit"), edit_finance_debt_path(debt), class: "button button-secondary button-sm" %></div></article><% end %></div><% else %><div class="empty-state"><p><%= t("debts.empty_state") %></p></div><% end %></section>
