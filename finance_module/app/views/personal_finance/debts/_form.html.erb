<%= form_with model: debt do |form| %><div class="form-group"><%= form.label :name, "Borç adı" %><%= form.text_field :name, required: true, class: "form-control" %></div><div class="form-grid"><div class="form-group"><%= form.label :total_amount, "Toplam tutar" %><%= form.number_field :total_amount, step: 0.01, required: true, class: "form-control" %></div><div class="form-group"><%= form.label :remaining_amount, "Kalan bakiye" %><%= form.number_field :remaining_amount, step: 0.01, required: true, class: "form-control" %></div></div><div class="form-grid"><div class="form-group"><%= form.label :interest_rate, "Faiz oranı (%)" %><%= form.number_field :interest_rate, step: 0.001, class: "form-control" %></div><div class="form-group"><%= form.label :monthly_payment, "Aylık ödeme" %><%= form.number_field :monthly_payment, step: 0.01, required: true, class: "form-control" %></div></div><div class="form-grid"><div class="form-group"><%= form.label :remaining_installments, "Kalan taksit" %><%= form.number_field :remaining_installments, min: 0, required: true, class: "form-control" %></div><div class="form-group"><%= form.label :next_payment_on, "Sonraki ödeme" %><%= form.date_field :next_payment_on, class: "form-control" %></div></div><div class="form-actions"><%= form.submit "Kaydet", class: "button button-primary" %><%= link_to "İptal", finance_debts_path, class: "button button-secondary" %></div><% end %>
