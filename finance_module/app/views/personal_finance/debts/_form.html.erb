<%= form_with model: debt, scope: :debt, url: debt.persisted? ? finance_debt_path(debt) : finance_debts_path do |form| %><div class="form-group"><%= form.label :name, t("debts.name") %><%= form.text_field :name, required: true, class: "form-control" %></div><div class="form-grid"><div class="form-group"><%= form.label :total_amount, t("debts.total_amount") %><%= form.number_field :total_amount, step: 0.01, required: true, class: "form-control" %></div><div class="form-group"><%= form.label :remaining_amount, t("debts.remaining_balance") %><%= form.number_field :remaining_amount, step: 0.01, required: true, class: "form-control" %></div></div><div class="form-grid"><div class="form-group"><%= form.label :interest_rate, t("debts.interest_rate") %><%= form.number_field :interest_rate, step: 0.001, class: "form-control" %></div><div class="form-group"><%= form.label :monthly_payment, t("debts.monthly_payment") %><%= form.number_field :monthly_payment, step: 0.01, required: true, class: "form-control" %></div></div><div class="form-grid"><div class="form-group"><%= form.label :remaining_installments, t("debts.remaining_installments") %><%= form.number_field :remaining_installments, min: 0, required: true, class: "form-control" %></div><div class="form-group"><%= form.label :next_payment_on, t("debts.next_payment") %><%= form.date_field :next_payment_on, class: "form-control" %></div></div><div class="form-actions"><%= form.submit t("debts.save"), class: "button button-primary" %><%= link_to t("app.common.cancel"), finance_debts_path, class: "button button-secondary" %></div><% end %>
