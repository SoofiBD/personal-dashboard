<header class="page-header">
  <div>
    <p class="eyebrow"><%= t("purchase_plans.eyebrow", default: "FİNANSAL PLANLAMA") %></p>
    <h1><%= t("purchase_plans.title", default: "Satın Alma Planları") %></h1>
    <p class="page-subtitle"><%= t("purchase_plans.subtitle", default: "Büyük harcamaları bütçenizi zorlamadan, güvenle planlayın.") %></p>
  </div>
  <%= link_to new_finance_purchase_plan_path, class: "button button-primary" do %>
    <%= finance_svg_icon("plus", class: "icon-sm") %>
    <span><%= t("purchase_plans.new_title", default: "Yeni Plan Ekle") %></span>
  <% end %>
</header>

<% if @purchase_plans.any? %>
  <div class="card-grid">
    <% @purchase_plans.each do |plan| %>
      <% status = plan.assessment.status %>
      <div class="card-item">
        <div class="card-item-header">
          <div>
            <div class="card-item-title"><%= plan.name %></div>
            <span class="badge-pill <%= status == :comfortable ? 'badge-status-comfortable' : (status == :plan ? 'badge-status-plan' : 'badge-status-defer') %>" style="margin-top: 0.35rem;">
              <%= t("purchase_plans.status_#{status}", default: status.to_s.humanize) %>
            </span>
          </div>
          <div class="transaction-actions">
            <%= link_to edit_finance_purchase_plan_path(plan), class: "action-btn", title: t("app.common.edit", default: "Düzenle") do %>
              <%= finance_svg_icon("edit") %>
            <% end %>
            <%= button_to finance_purchase_plan_path(plan), method: :delete, data: { turbo_confirm: t("app.common.confirm_delete", default: "Bu planı silmek istediğinizden emin misiniz?") }, class: "action-btn delete", title: t("app.common.delete", default: "Sil"), form: { style: "display: inline;" } do %>
              <%= finance_svg_icon("trash") %>
            <% end %>
          </div>
        </div>

        <div>
          <span class="metric-label"><%= t("purchase_plans.price", default: "Toplam Fiyat") %></span>
          <div class="card-item-balance">
            <%= dashboard_currency plan.price %>
          </div>
        </div>

        <div style="font-size: 0.82rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 0.25rem; border-top: 1px solid var(--border-subtle); padding-top: 0.75rem;">
          <div style="display: flex; justify-content: space-between;">
            <span><%= t("purchase_plans.down_payment", default: "Peşinat:") %></span>
            <strong style="color: var(--text-main); font-variant-numeric: tabular-nums;"><%= dashboard_currency plan.down_payment %></strong>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span><%= t("purchase_plans.monthly_cost", default: "Aylık Taksit:") %></span>
            <strong style="color: var(--text-main); font-variant-numeric: tabular-nums;"><%= dashboard_currency plan.monthly_cost %></strong>
          </div>
          <% if plan.planned_on %>
            <div style="display: flex; justify-content: space-between;">
              <span><%= t("purchase_plans.planned_on", default: "Hedef Tarihi:") %></span>
              <strong style="color: var(--text-main);"><%= l(plan.planned_on, format: "%d %b %Y") rescue plan.planned_on %></strong>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <section class="panel">
    <div class="empty-state">
      <p><%= t("app.common.empty_state", default: "Kayıtlı bir satın alma planı bulunmuyor.") %></p>
      <%= link_to t("purchase_plans.new_title", default: "İlk Planı Ekle"), new_finance_purchase_plan_path, class: "button button-secondary button-sm" %>
    </div>
  </section>
<% end %>


