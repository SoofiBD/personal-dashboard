<header class="page-header"><div><p class="eyebrow">PLANNING</p><h1>Purchase plans</h1><p class="page-subtitle">Make major purchases with confidence.</p></div><%= link_to "Add plan", new_finance_purchase_plan_path, class: "button button-primary" %></header><section class="panel"><div class="finance-list"><% @purchase_plans.each do |plan| %><article><span><%= plan.name %> · <%= number_to_currency plan.price %></span><strong><%= { comfortable: "Comfortable", plan: "Plan ahead", defer: "Defer" }[plan.assessment.status] %></strong></article><% end %></div></section>
