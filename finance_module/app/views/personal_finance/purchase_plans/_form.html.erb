<%= form_with model: @purchase_plan, url: @purchase_plan.persisted? ? finance_purchase_plan_path(@purchase_plan) : finance_purchase_plans_path do |form| %><%= render "personal_finance/shared/errors", record: @purchase_plan %><%= form.label :name, "Purchase" %><%= form.text_field :name, maxlength: 100 %><%= form.label :price, "Total price" %><%= form.number_field :price, step: 0.01, min: 0.01 %><%= form.label :down_payment, "Down payment" %><%= form.number_field :down_payment, step: 0.01, min: 0 %><%= form.label :monthly_cost, "Monthly installment" %><%= form.number_field :monthly_cost, step: 0.01, min: 0 %><%= form.label :planned_on, "Planned date" %><%= form.date_field :planned_on %><%= form.submit "Assess plan", class: "button button-primary" %><% end %>
