<%= form_with model: @exchange_rate, scope: :exchange_rate, url: @exchange_rate.persisted? ? finance_exchange_rate_path(@exchange_rate) : finance_exchange_rates_path do |form| %><%= render "personal_finance/shared/errors", record: @exchange_rate %><div class="form-group"><%= form.label :base_currency, "Kaynak para birimi" %><%= form.select :base_currency, %w[TRY USD EUR GBP] %></div><div class="form-group"><%= form.label :quote_currency, "Hedef para birimi" %><%= form.select :quote_currency, %w[TRY USD EUR GBP] %></div><div class="form-group"><%= form.label :rate, "Kur (1 kaynak = hedef)" %><%= form.number_field :rate, min: 0.000001, step: 0.000001, required: true %></div><div class="form-actions"><%= form.submit "Kuru Kaydet", class: "button button-primary" %></div><% end %>
