<%= form_with model: @exchange_rate, scope: :exchange_rate, url: @exchange_rate.persisted? ? finance_exchange_rate_path(@exchange_rate) : finance_exchange_rates_path, class: "exchange-form" do |form| %>
  <%= render "personal_finance/shared/errors", record: @exchange_rate %>

  <div class="currency-selectors-row">
    <div class="form-group currency-select-group">
      <%= form.label :base_currency, t("exchange_rates.base_currency", default: "Kaynak Para Birimi") %>
      <div class="custom-select-wrap">
        <%= form.select :base_currency, %w[TRY USD EUR GBP CHF CAD AUD JPY].map { |c| [c, c] }, {}, class: "custom-select" %>
      </div>
    </div>

    <div class="currency-swap-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M7 16V4m0 0L3 8m4-4l4 4M17 8v12m0 0l4-4m-4 4l-4-4"/>
      </svg>
    </div>

    <div class="form-group currency-select-group">
      <%= form.label :quote_currency, t("exchange_rates.quote_currency", default: "Hedef Para Birimi") %>
      <div class="custom-select-wrap">
        <%= form.select :quote_currency, %w[TRY USD EUR GBP CHF CAD AUD JPY].map { |c| [c, c] }, {}, class: "custom-select" %>
      </div>
    </div>
  </div>

  <div class="form-group">
    <%= form.label :rate, t("exchange_rates.rate", default: "Dönüşüm Kuru (1 Kaynak = Hedef)") %>
    <div class="rate-input-wrap">
      <%= form.number_field :rate, min: 0.000001, step: 0.000001, required: true, placeholder: t("exchange_rates.rate_placeholder", default: "Örn: 34.250000"), class: "rate-input" %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit t("exchange_rates.save_rate", default: "Kuru Kaydet"), class: "button button-primary exchange-submit-btn" %>
    <% if @exchange_rate.persisted? %>
      <%= link_to t("app.common.cancel", default: "İptal"), finance_exchange_rates_path, class: "button button-secondary" %>
    <% end %>
  </div>
<% end %>
