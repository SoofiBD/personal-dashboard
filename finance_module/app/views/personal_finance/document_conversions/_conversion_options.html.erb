<% defaults = {"extract_images_enabled" => true, "min_image_dimension" => 100, "strip_headers_footers" => true, "bind_captions_enabled" => true, "extract_annotations_enabled" => true, "include_yaml_frontmatter" => true, "fix_hyphenation_enabled" => true, "detect_tables" => true} %>
<% options = defaults.merge(local_assigns.fetch(:conversion_options, {})) %>
<details class="conversion-options" <%= "open" unless local_assigns[:compact] %>>
  <summary>Dönüştürme ayarları</summary>
  <p class="field-hint">Seçimler yalnızca bu dönüşüm isteğine uygulanır.</p>
  <div class="conversion-options-grid">
    <% {"extract_images_enabled" => "Görselleri çıkar", "strip_headers_footers" => "Tekrarlanan başlık ve footer’ları temizle", "bind_captions_enabled" => "Görsel başlıklarını bağla", "extract_annotations_enabled" => "PDF anotasyonlarını çıkar", "include_yaml_frontmatter" => "YAML ön bilgisi ekle", "fix_hyphenation_enabled" => "Satır sonu ve tireleri düzelt", "detect_tables" => "Tabloları Markdown’a çevir"}.each do |key, label| %>
      <label class="conversion-option">
        <%= hidden_field_tag "conversion_options[#{key}]", "0" %>
        <%= check_box_tag "conversion_options[#{key}]", "1", options[key] %>
        <span><%= label %></span>
      </label>
    <% end %>
    <div class="conversion-option conversion-option--select">
      <%= label_tag "conversion_options_min_image_dimension", "Minimum görsel boyutu" %>
      <%= select_tag "conversion_options[min_image_dimension]", options_for_select([["50 px", 50], ["100 px", 100], ["200 px", 200], ["300 px", 300], ["500 px", 500]], options["min_image_dimension"]), id: "conversion_options_min_image_dimension" %>
    </div>
  </div>
</details>
