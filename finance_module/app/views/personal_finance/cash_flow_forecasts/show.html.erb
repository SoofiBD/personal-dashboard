<header class="page-header">
  <div>
    <p class="eyebrow"><%= t("cash_flow_forecast.eyebrow", default: "İLERİYE DÖNÜK PLANLAMA") %></p>
    <h1><%= t("cash_flow_forecast.title", default: "Nakit Akışı Tahmini") %></h1>
    <p class="page-subtitle"><%= t("cash_flow_forecast.subtitle", default: "Gelecek aylardaki tahmini dönem sonu bakiyenizi görün.") %></p>
  </div>
</header>

<section class="panel forecast-assumptions" aria-labelledby="forecast-assumptions-title">
  <div class="panel-header"><div><h2 id="forecast-assumptions-title"><%= t("cash_flow_forecast.assumptions", default: "Varsayımlar") %></h2><p><%= t("cash_flow_forecast.assumptions_note", default: "Varsayımlar son üç aylık, tekrarlanmayan işlemlerin ortalamasıdır. Değerleri bu görünüm için değiştirebilirsiniz.") %></p></div></div>
  <%= form_with url: finance_cash_flow_forecast_path, method: :get, class: "forecast-assumptions-form" do %>
    <div class="filter-field">
      <%= label_tag :months, t("cash_flow_forecast.horizon", default: "Tahmin Ufku") %>
      <%= select_tag :months, options_for_select([[t("cash_flow_forecast.three_months", default: "3 ay"), 3], [t("cash_flow_forecast.six_months", default: "6 ay"), 6]], @forecast.months), class: "filter-input" %>
    </div>
    <div class="filter-field">
      <%= label_tag :baseline_income, t("cash_flow_forecast.baseline_income", default: "Aylık Baz Gelir") %>
      <%= number_field_tag :baseline_income, @forecast.baseline_income.round(2), class: "filter-input", min: 0, step: 0.01 %>
    </div>
    <div class="filter-field">
      <%= label_tag :baseline_expenses, t("cash_flow_forecast.baseline_expenses", default: "Aylık Baz Gider") %>
      <%= number_field_tag :baseline_expenses, @forecast.baseline_expenses.round(2), class: "filter-input", min: 0, step: 0.01 %>
    </div>
    <div class="filter-actions-col">
      <span class="filter-actions-label" aria-hidden="true">&nbsp;</span>
      <div class="filter-actions">
        <%= submit_tag t("cash_flow_forecast.update", default: "Tahmini Güncelle"), class: "button button-primary filter-submit-btn" %>
      </div>
    </div>
  <% end %>
</section>

<section class="finance-cards forecast-metrics" aria-label="<%= t('cash_flow_forecast.summary_aria', default: 'Tahmin özeti') %>">
  <article class="metric-card"><div class="metric-card-top"><span class="metric-label"><%= t("cash_flow_forecast.current_balance", default: "Bugünkü Bakiye") %></span><div class="metric-badge-icon icon-budget-badge"><%= finance_svg_icon("accounts") %></div></div><strong><%= dashboard_currency @forecast.starting_balance %></strong><span class="metric-note"><%= t("cash_flow_forecast.active_accounts", default: "Aktif hesapların toplamı") %></span></article>
  <article class="metric-card"><div class="metric-card-top"><span class="metric-label"><%= t("cash_flow_forecast.end_balance", default: "Tahmini Son Bakiye") %></span><div class="metric-badge-icon <%= @projection.last[:balance].negative? ? 'icon-expense-badge' : 'icon-income-badge' %>"><%= finance_svg_icon(@projection.last[:balance].negative? ? "expense" : "income") %></div></div><strong class="<%= @projection.last[:balance].negative? ? 'value-negative' : 'value-positive' %>"><%= dashboard_currency @projection.last[:balance] %></strong><span class="metric-note"><%= @projection.last[:label] %> sonu</span></article>
  <article class="metric-card"><div class="metric-card-top"><span class="metric-label"><%= t("cash_flow_forecast.commitments", default: "Bilinen Taahhütler") %></span><div class="metric-badge-icon icon-expense-badge"><%= finance_svg_icon("expense") %></div></div><strong class="value-negative"><%= dashboard_currency(@projection.sum { |month| month[:goal_contributions] + month[:purchase_commitments] }) %></strong><span class="metric-note"><%= @forecast.active_goals.size %> <%= t("cash_flow_forecast.active_goals", default: "aktif hedef") %> · <%= @forecast.purchase_plans.size %> <%= t("cash_flow_forecast.purchase_plans", default: "satın alma planı") %></span></article>
</section>

<section class="forecast-grid">
  <article class="panel">
    <div class="panel-header"><div><h2><%= t("cash_flow_forecast.timeline", default: "Tahmini Bakiye Zaman Çizelgesi") %></h2><p><%= t("cash_flow_forecast.timeline_note", default: "Düz çizgi bugünkü bakiyeyi, kesikli çizgi tahmini gösterir.") %></p></div></div>
    <figure class="chart-figure"><div class="forecast-chart-container"><canvas id="cash-flow-forecast-chart" tabindex="0" role="img" data-starting-balance="<%= @forecast.starting_balance %>" aria-label="<%= t('cash_flow_forecast.chart_aria', default: 'Gelecek aylara ait tahmini dönem sonu bakiye grafiği') %>"></canvas></div><figcaption class="chart-caption"><%= t("cash_flow_forecast.disclaimer", default: "Bu bir tahmindir; gerçekleşen gelir, gider ve planlar değişebilir.") %></figcaption></figure>
  </article>
  <article class="panel forecast-commitments-panel"><div class="panel-header"><div><h2><%= t("cash_flow_forecast.included", default: "Tahmine Dahil Edilenler") %></h2><p><%= t("cash_flow_forecast.included_note", default: "Her dönemin hesaplamasında görünür şekilde yer alır.") %></p></div></div><dl class="forecast-assumption-list"><div><dt><%= t("cash_flow_forecast.recurring", default: "Aktif tekrarlayan işlemler") %></dt><dd><%= t("cash_flow_forecast.recurring_note", default: "Kural tarihleri ve sıklığına göre") %></dd></div><div><dt><%= t("cash_flow_forecast.goals", default: "Aktif hedef katkıları") %></dt><dd><%= t("cash_flow_forecast.goals_note", default: "Hedef tamamlanana kadar aylık") %></dd></div><div><dt><%= t("cash_flow_forecast.purchases", default: "Yaklaşan satın alma planları") %></dt><dd><%= t("cash_flow_forecast.purchases_note", default: "Planlanan ayda toplam plan tutarı") %></dd></div></dl></article>
</section>

<section class="panel forecast-table-panel"><div class="panel-header"><div><h2><%= t("cash_flow_forecast.monthly_breakdown", default: "Aylık Tahmin Detayı") %></h2><p><%= t("cash_flow_forecast.monthly_breakdown_note", default: "Dönem sonu bakiyesinin nasıl hesaplandığını inceleyin.") %></p></div></div><div class="table-scroll"><table class="forecast-table"><thead><tr><th scope="col"><%= t("cash_flow_forecast.month", default: "Ay") %></th><th scope="col"><%= t("cash_flow_forecast.income", default: "Gelir") %></th><th scope="col"><%= t("cash_flow_forecast.expenses", default: "Gider") %></th><th scope="col"><%= t("cash_flow_forecast.goals", default: "Hedefler") %></th><th scope="col"><%= t("cash_flow_forecast.purchases", default: "Planlar") %></th><th scope="col"><%= t("cash_flow_forecast.net", default: "Net") %></th><th scope="col"><%= t("cash_flow_forecast.balance", default: "Dönem Sonu") %></th></tr></thead><tbody><% @projection.each do |month| %><tr><th scope="row"><%= month[:label] %></th><td><%= dashboard_currency(month[:baseline_income] + month[:recurring_income]) %></td><td><%= dashboard_currency(month[:baseline_expenses] + month[:recurring_expenses]) %></td><td><%= dashboard_currency month[:goal_contributions] %></td><td><%= dashboard_currency month[:purchase_commitments] %></td><td class="<%= month[:net_change].negative? ? 'value-negative' : 'value-positive' %>"><%= dashboard_currency month[:net_change] %></td><td><strong><%= dashboard_currency month[:balance] %></strong></td></tr><% end %></tbody></table></div></section>

<% chart_data = @projection.map { |month| {label: month[:label], balance: month[:balance]} } %>
<script type="application/json" id="cash-flow-forecast-data"><%= raw chart_data.to_json %></script>
