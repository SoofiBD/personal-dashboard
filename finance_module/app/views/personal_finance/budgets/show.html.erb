<header class="page-header"><div><p class="eyebrow">MONTHLY PLAN</p><h1><%= @budget.starts_on.strftime("%B %Y") %> budget</h1><p class="page-subtitle">Actual spending: <strong><%= number_to_currency @budget.actual_spending %></strong> · Remaining: <strong><%= number_to_currency @budget.remaining %></strong></p></div></header><section class="panel form-panel"><%= form_with url: finance_budget_path(@budget.starts_on.strftime("%Y-%m")), method: :patch do |form| %><%= fields_for :budget_period, @budget do |budget_form| %><%= budget_form.label :planned_income, "Planned income" %><%= budget_form.number_field :planned_income, step: 0.01, min: 0 %><% end %><% @expense_categories.each do |category| %><div><%= label_tag "allocations_#{category.id}_planned_amount", category.name %><%= hidden_field_tag "allocations[][category_id]", category.id %><%= number_field_tag "allocations[][planned_amount]", @budget.allocations.find { |a| a.category_id == category.id }&.planned_amount || 0, step: 0.01, min: 0 %></div><% end %><%= form.submit "Save budget", class: "button button-primary" %><% end %></section>
