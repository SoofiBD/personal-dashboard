<header class="page-header">
  <div>
    <p class="eyebrow"><%= t("budgets.eyebrow", default: "AYLIK BÜTÇE PLANI") %></p>
    <h1><%= t("budgets.title", month: l(@budget.starts_on, format: "%B %Y"), default: "#{l(@budget.starts_on, format: '%B %Y')} Bütçesi") %></h1>
    <p class="page-subtitle">
      <%= t("budgets.actual_spending", default: "Gerçekleşen Harcama:") %> <strong class="value-negative"><%= dashboard_currency @budget.actual_spending %></strong> · 
      <%= t("budgets.remaining", default: "Kalan Bütçe:") %> <strong class="<%= @budget.remaining >= 0 ? 'value-positive' : 'value-negative' %>"><%= dashboard_currency @budget.remaining %></strong>
    </p>
  </div>

  <%= form_with url: currency_finance_budget_path(@budget.starts_on.strftime("%Y-%m")), method: :patch, class: "currency-form" do |form| %>
    <div>
      <%= form.label :currency, t("budgets.display_currency", default: "Görüntüleme Para Birimi"), style: "font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 0.2rem;" %>
      <%= form.select :currency, %w[TRY USD EUR GBP], selected: current_panel_user.currency %>
    </div>
    <%= form.submit t("app.common.change", default: "Değiştir"), class: "button button-secondary" %>
  <% end %>
</header>

<section class="panel form-panel">
  <%= form_with url: finance_budget_path(@budget.starts_on.strftime("%Y-%m")), method: :patch do |form| %>
    <%= fields_for :budget_period, @budget do |budget_form| %>
      <div class="form-group">
        <%= budget_form.label :planned_income, t("budgets.planned_income", default: "Planlanan Toplam Gelir") %>
        <%= budget_form.number_field :planned_income, step: 0.01, min: 0, placeholder: "0.00" %>
      </div>
    <% end %>

    <div style="margin: 2rem 0 1rem;">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.35rem;"><%= t("budgets.category_limits", default: "Kategori Bazlı Harcama Limitleri") %></h3>
      <p style="font-size: 0.85rem; color: var(--text-muted);"><%= t("budgets.category_limits_desc", default: "Her gider kategorisi için bu ay hedeflenen harcama miktarını belirleyin.") %></p>
    </div>

    <div class="budget-allocation-list">
      <% @expense_categories.each do |category| %>
        <% current_spent = @category_current_spent ? @category_current_spent[category.id].to_f : 0 %>
        <% allocation = @budget.allocations.find { |a| a.category_id == category.id } %>
        <% is_sub = category.parent_id.present? %>
        
        <div class="form-group budget-category-input-group <%= 'is-subcategory' if is_sub %>">
          <div class="budget-category-header">
            <div class="budget-cat-name-wrap">
              <span class="tag-dot" style="background-color: <%= category.color.presence || '#3B82F6' %>;"></span>
              <span class="budget-cat-label"><%= category.name %></span>
              <% if is_sub %>
                <span class="badge-sub-category"><%= t("budgets.sub_category", default: "Alt Kategori") %></span>
              <% elsif category.children.any? %>
                <span class="badge-parent-category"><%= t("budgets.parent_category", default: "Ana Kategori") %></span>
              <% end %>
            </div>
            <% if current_spent > 0 %>
              <span class="budget-spent-hint">
                <%= t("budgets.current_month_spent", amount: dashboard_currency(current_spent), default: "Bu ayki harcama: #{dashboard_currency(current_spent)}") %>
              </span>
            <% end %>
          </div>
          <%= hidden_field_tag "allocations[][category_id]", category.id %>
          <%= number_field_tag "allocations[][planned_amount]", allocation&.planned_amount || 0, step: 0.01, min: 0, placeholder: "0.00", class: "budget-limit-input" %>
        </div>
      <% end %>
    </div>

    <div class="form-actions">
      <%= form.submit t("budgets.save", default: "Bütçeyi Kaydet"), class: "button button-primary" %>
      <%= link_to t("budgets.back_to_dashboard", default: "Genel Bakışa Dön"), finance_root_path, class: "button button-secondary" %>
    </div>
  <% end %>
</section>


