<header class="page-header">
  <div>
    <p class="eyebrow"><%= t("budgets.eyebrow") %></p>
    <h1><%= t("budgets.title", month: l(@budget.starts_on, format: "%B %Y")) %></h1>
    <p class="page-subtitle">
      <%= t("budgets.actual_spending") %> <strong class="value-negative"><%= dashboard_currency @budget.actual_spending %></strong> ·
      <%= t("budgets.remaining") %> <strong class="<%= @budget.remaining >= 0 ? 'value-positive' : 'value-negative' %>"><%= dashboard_currency @budget.remaining %></strong>
    </p>
  </div>

  <%= form_with url: currency_finance_budget_path(@budget.starts_on.strftime("%Y-%m")), method: :patch, class: "currency-form" do |form| %>
    <div>
      <%= form.label :currency, t("budgets.display_currency"), style: "font-size: 0.75rem; color: var(--text-muted); display: block; margin-bottom: 0.2rem;" %>
      <%= form.select :currency, %w[TRY USD EUR GBP], selected: current_panel_user.currency %>
    </div>
    <%= form.submit t("app.common.change"), class: "button button-secondary" %>
  <% end %>
</header>

<section class="panel" style="margin-bottom: 1.5rem;">
  <div class="panel-header">
    <div>
      <h2><%= t("budget_templates.templates_title") %></h2>
      <p><%= t("budget_templates.templates_desc") %></p>
    </div>
    <%= link_to t("budget_templates.manage_templates"), finance_budget_templates_path, class: "button button-secondary button-sm" %>
  </div>

  <% if @budget.allocations.none? %>
    <%= form_with url: apply_template_finance_budget_path(@budget.starts_on.strftime("%Y-%m")), class: "template-action-form" do |form| %>
      <div class="form-group" style="margin-bottom: 0; flex: 1;">
        <%= form.label :template_id, t("budget_templates.select_template") %>
        <%= form.select :template_id, options_from_collection_for_select(@budget_templates, :id, :name), {}, class: "form-control" %>
      </div>
      <%= form.submit t("budget_templates.apply_template"), class: "button button-primary" %>
    <% end %>
  <% else %>
    <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem;"><%= t("budget_templates.allocations_exist") %></p>
  <% end %>

  <%= form_with url: save_as_template_finance_budget_path(@budget.starts_on.strftime("%Y-%m")), class: "template-action-form" do |form| %>
    <div class="form-group" style="margin-bottom: 0; flex: 1;">
      <%= form.label :name, t("budget_templates.save_as_template_label") %>
      <%= form.text_field :name, maxlength: 80, required: true, placeholder: t("budget_templates.save_as_template_placeholder"), class: "form-control" %>
    </div>
    <%= form.submit t("budget_templates.save_template"), class: "button button-secondary" %>
  <% end %>
</section>

<% if @can_copy_previous %>
  <section class="panel" style="margin-bottom: 1.5rem; border-color: rgba(59, 130, 246, 0.35);">
    <div style="display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
      <div>
        <p style="font-weight: 600; color: var(--text-main); margin-bottom: 0.25rem;">
          <%= t("budgets.copy_previous_prompt") %>
        </p>
        <p style="font-size: 0.85rem; color: var(--text-muted);">
          <%= t("budgets.copy_previous_hint") %>
        </p>
      </div>
      <%= button_to t("budgets.copy_previous"),
            copy_previous_finance_budget_path(@budget.starts_on.strftime("%Y-%m")),
            method: :patch, class: "button button-primary" %>
    </div>
  </section>
<% end %>

<section class="panel form-panel">
  <%= form_with url: finance_budget_path(@budget.starts_on.strftime("%Y-%m")), method: :patch, id: "budget-edit-form" do |form| %>
    <div class="form-group">
      <%= form.label :planned_income, t("budgets.planned_income") %>
      <div style="position: relative;">
        <input type="text"
               id="budget-total-planned-display"
               class="form-control"
               style="font-size: 1.15rem; font-weight: 700; color: #60A5FA; background: rgba(59, 130, 246, 0.08); border-color: rgba(59, 130, 246, 0.35); cursor: default;"
               value="<%= dashboard_currency @budget.planned_spending %>"
               readonly />
      </div>
      <small style="display: block; margin-top: 0.35rem; color: var(--text-muted); font-size: 0.8rem;">
        <%= t("budgets.planned_income_auto_note") %>
      </small>
    </div>

    <div style="margin: 2rem 0 1rem;">
      <h3 style="font-size: 1.05rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.35rem;"><%= t("budgets.category_limits") %></h3>
      <p style="font-size: 0.85rem; color: var(--text-muted);"><%= t("budgets.category_limits_desc") %></p>
    </div>

    <div class="budget-allocation-list">
      <% @expense_categories.each do |category| %>
        <% current_spent = @category_current_spent ? @category_current_spent[category.id].to_f : 0 %>
        <% allocation = @budget.allocations.find { |a| a.category_id == category.id } %>
        <% is_sub = category.parent_id.present? %>
        
        <div class="form-group budget-category-input-group <%= 'is-subcategory' if is_sub %>">
          <div class="budget-category-header">
            <div class="budget-cat-name-wrap">
              <span class="tag-dot" style="background-color: <%= category.color.presence || '#3B82F6' %>;"></span>
              <span class="budget-cat-label"><%= category.name %></span>
              <% if is_sub %>
                <span class="badge-sub-category"><%= t("budgets.sub_category") %></span>
              <% elsif category.children.any? %>
                <span class="badge-parent-category"><%= t("budgets.parent_category") %></span>
              <% end %>
            </div>
            <% if current_spent > 0 %>
              <span class="budget-spent-hint">
                <%= t("budgets.current_month_spent", amount: dashboard_currency(current_spent)) %>
              </span>
            <% end %>
          </div>
          <%= hidden_field_tag "allocations[][category_id]", category.id %>
          <%= number_field_tag "allocations[][planned_amount]", allocation&.planned_amount || 0, step: 0.01, min: 0, placeholder: "0.00", class: "budget-limit-input" %>
        </div>
      <% end %>
    </div>

    <div class="form-actions">
      <%= form.submit t("budgets.save"), class: "button button-primary" %>
      <%= link_to t("budgets.back_to_dashboard"), finance_root_path, class: "button button-secondary" %>
    </div>
  <% end %>
</section>
