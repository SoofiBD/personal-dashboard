<header class="page-header"><div><p class="eyebrow"><%= t("tags.eyebrow", default: "ESNEK GRUPLAMA") %></p><h1><%= t("tags.report", default: "Etiket Harcama Raporu") %></h1><p class="page-subtitle"><%= t("tags.report_subtitle", default: "Etiketlenmiş giderleri kategori sınırlarından bağımsız inceleyin.") %></p></div><%= link_to t("tags.manage", default: "Etiket Yönetimi"), finance_tags_path, class: "button button-secondary" %></header>
<section class="panel report-filter-panel"><%= form_with url: report_finance_tags_path, method: :get, class: "report-date-form" do %><div class="filter-field"><%= label_tag :from, t("spending_report.from", default: "Başlangıç") %><%= date_field_tag :from, @from, class: "filter-input", max: @to %></div><div class="filter-field"><%= label_tag :to, t("spending_report.to", default: "Bitiş") %><%= date_field_tag :to, @to, class: "filter-input", min: @from %></div><div class="filter-actions"><%= submit_tag t("spending_report.apply", default: "Raporu Güncelle"), class: "button button-primary button-sm" %></div><% end %></section>
<section class="panel"><div class="panel-header"><div><h2><%= t("tags.report_totals", default: "Etikete Göre Giderler") %></h2><p><%= l(@from) %> – <%= l(@to) %></p></div></div><% if @tag_spending.any? %><div class="tag-report-list"><% @tag_spending.each do |tag| %><div class="tag-management-row"><span class="transaction-tag"><%= tag.name %></span><strong class="value-negative"><%= dashboard_currency tag.total_spending %></strong></div><% end %></div><% else %><div class="empty-state"><p><%= t("tags.report_empty", default: "Bu dönem için etiketlenmiş bir gider bulunmuyor.") %></p></div><% end %></section>
