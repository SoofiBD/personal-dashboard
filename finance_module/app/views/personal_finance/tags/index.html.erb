<header class="page-header"><div><p class="eyebrow"><%= t("tags.eyebrow", default: "ESNEK GRUPLAMA") %></p><h1><%= t("tags.title", default: "İşlem Etiketleri") %></h1><p class="page-subtitle"><%= t("tags.subtitle", default: "İşlemleri proje, etkinlik veya geçici ihtiyaçlara göre gruplandırın.") %></p></div><div class="page-header-actions"><%= link_to t("tags.report", default: "Etiket Harcama Raporu"), report_finance_tags_path, class: "button button-secondary" %><%= link_to new_finance_tag_path, class: "button button-primary" do %><%= finance_svg_icon("plus", class: "icon-sm") %><span><%= t("tags.new", default: "Etiket Ekle") %></span><% end %></div></header>

<section class="panel tag-quick-create"><div class="panel-header"><div><h2><%= t("tags.quick_create", default: "Hızlı Etiket Oluştur") %></h2><p><%= t("tags.quick_create_note", default: "Etiketler işlem formunda otomatik tamamlamayla da oluşturulabilir.") %></p></div></div><%= render "form" %></section>

<% if @tags.any? %>
  <section class="panel tag-management-panel"><div class="panel-header"><div><h2><%= t("tags.manage", default: "Etiket Yönetimi") %></h2><p><%= t("tags.manage_note", default: "Adını değiştirin, silin veya yinelenen etiketleri birleştirin.") %></p></div></div><div class="tag-management-list"><% @tags.each do |tag| %><article class="tag-management-row"><div><span class="transaction-tag"><%= tag.name %></span><span class="tag-usage-count"><%= tag.transactions_count %> <%= t("tags.transaction_count", default: "işlem") %></span></div><div class="transaction-actions"><%= link_to edit_finance_tag_path(tag), class: "action-btn", title: t("app.common.edit", default: "Düzenle") do %><%= finance_svg_icon("edit") %><% end %><%= button_to finance_tag_path(tag), method: :delete, data: {turbo_confirm: t("app.common.confirm_delete", default: "Bu etiketi silmek istediğinizden emin misiniz?")}, class: "action-btn delete", title: t("app.common.delete", default: "Sil"), form: {style: "display: inline;"} do %><%= finance_svg_icon("trash") %><% end %></div></article><% end %></div>
  <%= form_with url: merge_finance_tags_path, method: :patch, class: "tag-merge-form" do %><div class="filter-field"><%= label_tag :source_ids, t("tags.merge_sources", default: "Birleştirilecek etiketler") %><%= select_tag "source_ids[]", options_from_collection_for_select(@tags, :id, :name), multiple: true, class: "filter-input", size: [@tags.size, 5].min %></div><div class="filter-field"><%= label_tag :target_id, t("tags.merge_target", default: "Hedef etiket") %><%= select_tag :target_id, options_from_collection_for_select(@tags, :id, :name), class: "filter-input" %></div><div class="filter-actions"><%= submit_tag t("tags.merge", default: "Etiketleri Birleştir"), class: "button button-secondary button-sm" %></div><% end %>
</section>
<% else %><section class="panel empty-state"><p><%= t("tags.empty", default: "Henüz etiket oluşturulmadı.") %></p></section><% end %>
