<%= form_with model: subscription, scope: :subscription, url: subscription.persisted? ? finance_subscription_path(subscription) : finance_subscriptions_path, class: "subscription-form" do |form| %>
  <% if subscription.errors.any? %><div class="form-errors"><%= subscription.errors.full_messages.to_sentence %></div><% end %>
  <div class="form-group"><%= form.label :name, t("subscriptions.name") %><%= form.text_field :name, required: true, maxlength: 100, class: "form-control", placeholder: t("subscriptions.name_placeholder") %></div>
  <div class="form-grid"><div class="form-group"><%= form.label :amount, t("subscriptions.amount") %><%= form.number_field :amount, min: 0.01, step: 0.01, required: true, class: "form-control" %></div><div class="form-group"><%= form.label :billing_interval, t("subscriptions.billing_interval") %><%= form.select :billing_interval, [[t("subscriptions.intervals.monthly"), "monthly"], [t("subscriptions.intervals.yearly"), "yearly"]], {}, class: "form-control" %></div></div>
  <div class="form-grid"><div class="form-group"><%= form.label :renewal_on, t("subscriptions.renewal_on") %><%= form.date_field :renewal_on, class: "form-control" %></div><div class="form-group"><%= form.label :last_used_on, t("subscriptions.last_used_on") %><%= form.date_field :last_used_on, class: "form-control" %></div></div>
  <div class="form-group"><%= form.label :recurring_rule_id, t("subscriptions.link_recurring") %><%= form.select :recurring_rule_id, options_from_collection_for_select(@recurring_rules, :id, :note, subscription.recurring_rule_id), {include_blank: t("subscriptions.no_link")}, class: "form-control" %></div>
  <label class="checkbox-label"><%= form.check_box :active %> <%= t("subscriptions.active_subscription") %></label>
  <div class="form-actions"><%= form.submit t("subscriptions.save"), class: "button button-primary" %><%= link_to t("app.common.cancel"), finance_subscriptions_path, class: "button button-secondary" %></div>
<% end %>
