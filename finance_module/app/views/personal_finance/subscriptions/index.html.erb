<header class="page-header"><div><p class="eyebrow"><%= t("subscriptions.eyebrow") %></p><h1><%= t("subscriptions.title") %></h1><p class="page-subtitle"><%= t("subscriptions.subtitle") %></p></div><%= link_to t("subscriptions.add"), new_finance_subscription_path, class: "button button-primary" %></header>
<section class="finance-cards"><article class="metric-card"><span class="metric-label"><%= t("subscriptions.monthly_total") %></span><strong class="value-negative"><%= dashboard_currency @monthly_total %></strong></article><article class="metric-card"><span class="metric-label"><%= t("subscriptions.yearly_total") %></span><strong class="value-negative"><%= dashboard_currency @yearly_total %></strong></article><article class="metric-card"><span class="metric-label"><%= t("subscriptions.upcoming_renewal") %></span><strong><%= @upcoming_subscriptions.size %></strong><span class="metric-note"><%= t("subscriptions.next_14_days") %></span></article></section>
<% if @upcoming_subscriptions.any? %><section class="panel subscription-reminders"><div class="panel-header"><div><h2><%= t("subscriptions.upcoming_renewals_title") %></h2><p><%= t("subscriptions.upcoming_renewals_desc") %></p></div></div><div class="subscription-list"><% @upcoming_subscriptions.each do |subscription| %><div class="subscription-row is-upcoming"><strong><%= subscription.name %></strong><span><%= l(subscription.renewal_on) %></span></div><% end %></div></section><% end %>
<section class="panel"><div class="panel-header"><div><h2><%= t("subscriptions.list_title") %></h2><p><%= t("subscriptions.list_desc") %></p></div></div><% if @subscriptions.any? %><div class="subscription-list"><% @subscriptions.each do |subscription| %><article class="subscription-row"><div><div class="subscription-title"><h3><%= subscription.name %></h3><% if subscription.potentially_cancellable? %><span class="template-badge custom"><%= t("subscriptions.review") %></span><% end %><% unless subscription.active? %><span class="template-badge"><%= t("subscriptions.inactive") %></span><% end %></div><p><%= subscription.monthly? ? t("subscriptions.intervals.monthly") : t("subscriptions.intervals.yearly") %> · <%= subscription.recurring_rule ? t("subscriptions.linked_recurring") : t("subscriptions.manual_entry") %><%= " · #{t('subscriptions.last_used_prefix')} #{l(subscription.last_used_on)}" if subscription.last_used_on %></p></div><div class="subscription-actions"><strong class="value-negative"><%= dashboard_currency subscription.amount %></strong><%= link_to t("app.common.edit"), edit_finance_subscription_path(subscription), class: "button button-secondary button-sm" %><%= button_to t("app.common.delete"), finance_subscription_path(subscription), method: :delete, data: {turbo_confirm: t("subscriptions.confirm_delete")}, class: "button button-danger button-sm" %></div></article><% end %></div><% else %><div class="empty-state"><p><%= t("subscriptions.empty_state") %></p><%= link_to t("subscriptions.add_first"), new_finance_subscription_path, class: "button button-secondary button-sm" %></div><% end %></section>
