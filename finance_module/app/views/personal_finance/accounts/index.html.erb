<header class="page-header">
  <div>
    <p class="eyebrow"><%= t("accounts.eyebrow", default: "FİNANSAL TEMELLER") %></p>
    <h1><%= t("accounts.title", default: "Hesaplar") %></h1>
    <p class="page-subtitle"><%= t("accounts.subtitle", default: "Tüm banka, kredi kartı ve nakit bakiyelerinizi tek bir yerden yönetin.") %></p>
  </div>
  <%= link_to new_finance_account_path, class: "button button-primary" do %>
    <%= finance_svg_icon("plus", class: "icon-sm") %>
    <span><%= t("accounts.new_title", default: "Yeni Hesap Ekle") %></span>
  <% end %>
</header>

<% if @accounts.any? %>
  <section class="panel" style="margin-bottom: 1.5rem;">
    <h2 style="margin-top:0;">Toplam Net Değer</h2>
    <svg viewBox="0 0 300 70" role="img" aria-label="Son altı ay toplam net değer trendi" style="width:100%;max-width:520px;height:90px;">
      <% values = @net_worth_history.map { |point| point[:balance] }; min = values.min; range = values.max - min; points = values.each_with_index.map { |value, index| "#{index * 60},#{60 - ((value - min) / (range.zero? ? 1 : range) * 50)}" }.join(" ") %>
      <polyline points="<%= points %>" fill="none" stroke="#60A5FA" stroke-width="3" />
    </svg>
    <p class="metric-note"><%= dashboard_currency @net_worth_history.last[:balance] %> · son 6 ay</p>
  </section>
  <div class="card-grid">
    <% @accounts.each do |account| %>
      <div class="card-item">
        <div class="card-item-header">
          <div>
            <div class="card-item-title"><%= account.name %></div>
            <span class="badge-pill badge-pill-subtle" style="margin-top: 0.35rem;">
              <%= t("accounts.kinds.#{account.kind}", default: account.kind.humanize) %>
            </span>
          </div>
          <div class="transaction-actions">
            <%= link_to edit_finance_account_path(account), class: "action-btn", title: t("app.common.edit", default: "Düzenle") do %>
              <%= finance_svg_icon("edit") %>
            <% end %>
            <%= button_to finance_account_path(account), method: :delete, data: { turbo_confirm: t("app.common.confirm_delete", default: "Bu hesabı silmek istediğinizden emin misiniz?") }, class: "action-btn delete", title: t("app.common.delete", default: "Sil"), form: { style: "display: inline;" } do %>
              <%= finance_svg_icon("trash") %>
            <% end %>
          </div>
        </div>

        <div>
          <span class="metric-label"><%= t("accounts.current_balance", default: "Mevcut Bakiye") %></span>
          <div class="card-item-balance <%= account.current_balance >= 0 ? "value-positive" : "value-negative" %>">
            <%= dashboard_currency account.current_balance %>
          </div>
          <p class="metric-note"><%= t("accounts.opening_balance", default: "Açılış bakiyesi") %>: <%= dashboard_currency account.opening_balance %></p>
          <% history = @account_histories[account]; values = history.map { |point| point[:balance] }; minimum = values.min; range = values.max - minimum; points = values.each_with_index.map { |value, index| "#{index * 20},#{42 - ((value - minimum) / (range.zero? ? 1 : range) * 34)}" }.join(" ") %>
          <svg viewBox="0 0 100 45" role="img" aria-label="<%= account.name %> son altı ay bakiye trendi" style="width:100%;height:50px;margin-top:.75rem;"><polyline points="<%= points %>" fill="none" stroke="#34D399" stroke-width="3" /></svg>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <section class="panel">
    <div class="empty-state">
      <p><%= t("accounts.empty_state", default: t("app.common.empty_state", default: "Kayıtlı bir hesap bulunmuyor.")) %></p>
      <%= link_to t("accounts.add_first", default: t("accounts.new_title", default: "İlk Hesabı Ekle")), new_finance_account_path, class: "button button-secondary button-sm" %>
    </div>
  </section>
<% end %>

