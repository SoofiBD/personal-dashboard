<header class="page-header">
  <div>
    <p class="eyebrow"><%= t("accounts.eyebrow") %></p>
    <h1><%= t("accounts.title") %></h1>
    <p class="page-subtitle"><%= t("accounts.subtitle") %></p>
  </div>
  <%= link_to new_finance_account_path, class: "button button-primary" do %>
    <%= finance_svg_icon("plus", class: "icon-sm") %>
    <span><%= t("accounts.new_title") %></span>
  <% end %>
</header>

<% if @accounts.any? %>
  <section class="panel" style="margin-bottom: 1.5rem;">
    <h2 style="margin-top:0;"><%= t("accounts.total_net_worth") %></h2>
    <svg viewBox="0 0 300 70" role="img" aria-label="<%= t('accounts.net_worth_trend_aria') %>" style="width:100%;max-width:520px;height:90px;">
      <% values = @net_worth_history.map { |point| point[:balance] }; min = values.min; range = values.max - min; points = values.each_with_index.map { |value, index| "#{index * 60},#{60 - ((value - min) / (range.zero? ? 1 : range) * 50)}" }.join(" ") %>
      <polyline points="<%= points %>" fill="none" stroke="#60A5FA" stroke-width="3" />
    </svg>
    <p class="metric-note"><%= dashboard_currency @converted_total %> · <%= current_panel_user.currency %> <%= t("accounts.equivalent") %></p>
    <% if @unconverted_accounts.any? %><p class="metric-note"><%= t("accounts.excluded_no_rate") %> <%= @unconverted_accounts.map(&:name).join(", ") %></p><% end %>
  </section>
  <div class="card-grid">
    <% @accounts.each do |account| %>
      <div class="card-item">
        <div class="card-item-header">
          <div>
            <div class="card-item-title"><%= account.name %></div>
            <span class="badge-pill badge-pill-subtle" style="margin-top: 0.35rem;">
              <%= t("accounts.kinds.#{account.kind}", default: account.kind.humanize) %>
            </span>
          </div>
          <div class="transaction-actions">
            <%= link_to edit_finance_account_path(account), class: "action-btn", title: t("app.common.edit") do %>
              <%= finance_svg_icon("edit") %>
            <% end %>
            <%= button_to finance_account_path(account), method: :delete, data: { turbo_confirm: t("app.common.confirm_delete") }, class: "action-btn delete", title: t("app.common.delete"), form: { style: "display: inline;" } do %>
              <%= finance_svg_icon("trash") %>
            <% end %>
          </div>
        </div>

        <div>
          <span class="metric-label"><%= t("accounts.current_balance") %></span>
          <div class="card-item-balance <%= account.current_balance >= 0 ? "value-positive" : "value-negative" %>">
            <%= account_currency account.current_balance, account %>
          </div>
          <p class="metric-note"><%= t("accounts.opening_balance") %>: <%= account_currency account.opening_balance, account %></p>
          <% history = @account_histories[account]; values = history.map { |point| point[:balance] }; minimum = values.min; range = values.max - minimum; points = values.each_with_index.map { |value, index| "#{index * 20},#{42 - ((value - minimum) / (range.zero? ? 1 : range) * 34)}" }.join(" ") %>
          <svg viewBox="0 0 100 45" role="img" aria-label="<%= t('accounts.balance_trend_aria', name: account.name) %>" style="width:100%;height:50px;margin-top:.75rem;"><polyline points="<%= points %>" fill="none" stroke="#34D399" stroke-width="3" /></svg>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <section class="panel">
    <div class="empty-state">
      <p><%= t("accounts.empty_state") %></p>
      <%= link_to t("accounts.add_first"), new_finance_account_path, class: "button button-secondary button-sm" %>
    </div>
  </section>
<% end %>
