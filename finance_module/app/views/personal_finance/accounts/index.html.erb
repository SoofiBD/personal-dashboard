<header class="page-header"><div><p class="eyebrow">FOUNDATIONS</p><h1>Accounts</h1><p class="page-subtitle">Keep your balances organized in one place.</p></div><%= link_to "Add account", new_finance_account_path, class: "button button-primary" %></header><section class="panel"><div class="finance-list"><% @accounts.each do |account| %><article><span><%= account.name %> · <%= account.kind.humanize %></span><strong><%= number_to_currency account.current_balance %></strong></article><% end %></div></section>
