<%= form_with model: @account, scope: :account, url: @account.persisted? ? finance_account_path(@account) : finance_accounts_path do |form| %>
  <%= render "personal_finance/shared/errors", record: @account %>

  <div class="form-group">
    <%= form.label :name, t("accounts.name", default: "Hesap Adı") %>
    <%= form.text_field :name, maxlength: 80, placeholder: t("accounts.name_placeholder", default: "Örn: Garanti Vadesiz, Nakit Cüzdan, Bonus Kart"), required: true %>
  </div>

  <div class="form-group">
    <%= form.label :currency, t("accounts.currency", default: "Hesap Para Birimi") %>
    <%= form.select :currency, %w[TRY USD EUR GBP], selected: @account.currency.presence || current_panel_user.currency %>
  </div>

  <div class="form-group">
    <%= form.label :kind, t("accounts.kind", default: "Hesap Türü") %>
    <%= form.select :kind, [[t("accounts.kinds.bank", default: "Banka Hesabı"), "bank"], [t("accounts.kinds.card", default: "Kredi Kartı"), "card"], [t("accounts.kinds.cash", default: "Nakit Cüzdan"), "cash"], [t("accounts.kinds.savings", default: "Birikim Hesabı"), "savings"]] %>
  </div>

  <div class="form-group">
    <%= form.label :opening_balance, t("accounts.opening_balance", default: "Açılış Bakiyesi") %>
    <%= form.number_field :opening_balance, step: 0.01, placeholder: "0.00", required: true %>
  </div>

  <div class="form-actions">
    <%= form.submit @account.persisted? ? t("accounts.update", default: "Hesabı Güncelle") : t("accounts.save", default: "Hesabı Kaydet"), class: "button button-primary" %>
    <%= link_to t("app.common.cancel", default: "İptal"), finance_accounts_path, class: "button button-secondary" %>
  </div>
<% end %>
