<%= form_with model: @account, url: @account.persisted? ? finance_account_path(@account) : finance_accounts_path do |form| %><%= render "personal_finance/shared/errors", record: @account %><%= form.label :name, "Account name" %><%= form.text_field :name, maxlength: 80 %><%= form.label :kind, "Account type" %><%= form.select :kind, PersonalFinance::Account.kinds.keys.map { |kind| [kind.humanize, kind] } %><%= form.label :opening_balance, "Opening balance" %><%= form.number_field :opening_balance, step: 0.01 %><%= form.submit "Save account", class: "button button-primary" %><% end %>
