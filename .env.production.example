DASHBOARD_DOMAIN=dashboard.example.com
DASHBOARD_TIME_ZONE=Europe/Istanbul
POSTGRES_DB=personal_dashboard_production
POSTGRES_USER=personal_dashboard
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://personal_dashboard:replace-with-a-random-password@db:5432/personal_dashboard_production
RAILS_MASTER_KEY=copy-the-production-master-key-here
# Optional NAS overlay: include -f compose.nas.yaml and set both values.
NAS_WORKER_URL=http://nas-worker:8000
NAS_API_TOKEN=
