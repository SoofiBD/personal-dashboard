DASHBOARD_DOMAIN=dashboard.example.com
DASHBOARD_TIME_ZONE=Europe/Istanbul
POSTGRES_DB=personal_dashboard_production
POSTGRES_USER=personal_dashboard
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://personal_dashboard:replace-with-a-random-password@db:5432/personal_dashboard_production
# Optional AI provider and password-reset email (configure SMTP before relying on web resets):
GEMINI_API_KEY=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
# Secrets are now loaded from Docker secret files (./secrets/*.txt)
# Create the following files in ./secrets/:
# rails_master_key.txt      - 32+ char base64 key (rails secret)
# pdf_worker_api_key.txt    - 32+ char key for PDF worker auth
# postgres_password.txt     - PostgreSQL password
