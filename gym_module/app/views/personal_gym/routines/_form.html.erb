<header class="page-header">
  <div>
    <p class="eyebrow"><%= t("gym.routines.eyebrow", default: "Antrenman Planları") %></p>
    <h1><%= routine.persisted? ? routine.name : t("gym.new_routine", default: "Yeni Plan") %></h1>
    <p class="page-subtitle"><%= t("gym.routines.form_hint", default: "Plan adı ve açıklama.") %></p>
  </div>
  <%= link_to gym_routines_path, class: "button button-secondary" do %>
    <span><%= t("app.common.cancel", default: "İptal") %></span>
  <% end %>
</header>

<section class="panel">
  <%= form_with model: routine, scope: :gym_routine, url: routine.persisted? ? gym_routine_path(routine) : gym_routines_path do |form| %>
    <div class="form-group">
      <%= form.label :name, t("gym.fields.routine_name", default: "Plan Adı") %>
      <%= form.text_field :name, maxlength: 120, placeholder: t("gym.name_placeholder", default: "Örn: Full Body 3 Gün"), required: true %>
    </div>

    <div class="form-group">
      <%= form.label :description, t("gym.fields.description", default: "Açıklama") %>
      <%= form.text_area :description, maxlength: 500, rows: 3 %>
    </div>

    <div class="form-actions">
      <%= form.submit t("gym.save", default: "Kaydet"), class: "button button-primary" %>
      <% if routine.persisted? %>
        <%= link_to t("gym.manage_exercises", default: "Egzersizleri Düzenle"), edit_gym_routine_path(routine), class: "button button-secondary" %>
      <% end %>
    </div>
  <% end %>
</section>
