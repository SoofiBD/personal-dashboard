<div class="learning-shell"><%= render "header" %><p><%= t("learning.source_hint") %></p><%= form_with url: learning_library_path, method: :get, class: "learning-filters" do |f| %><div><%= f.label :q, t("learning.search") %><%= f.search_field :q, value: params[:q] %></div><%= f.submit t("learning.search"), class: "btn btn-secondary" %><% end %>
<h2><%= t("learning.questions") %> (<%= @questions.size %>)</h2><section class="learning-grid"><% @questions.each do |q| %><article class="learning-panel"><div class="learning-meta"><span><%= q['topic'] %></span><span><%= t("learning.difficulties.#{q['difficulty'].downcase}") %></span></div><h3><%= q['title'] %></h3><p><%= q['duration'] %> <%= t("learning.minute") %></p><% if @added.include?("question:#{q['slug']}") %><span><%= t("learning.added") %></span><% else %><%= button_to t("learning.add"), learning_items_path, params: {question: q['slug']}, class: "btn btn-secondary" %><% end %></article><% end %></section>
<h2><%= t("learning.resources") %> (<%= @resources.size %>)</h2><section class="learning-grid"><% @resources.each do |r| %><article class="learning-panel"><h3><%= link_to r['title'], learning_resource_path(r['id']) %></h3><span><%= t("learning.original") %></span></article><% end %></section><% if @resources.empty? && @questions.empty? %><p><%= t("learning.no_results") %></p><% end %><p>Tech Interview Handbook · Yangshun Tay · MIT</p></div>
