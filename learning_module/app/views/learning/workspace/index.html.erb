<div class="learning-shell"><%= render "header" %>
<section class="learning-stats" aria-label="<%= t('learning.roadmap') %>">
<% {total: @all.size, completed: @all.count { |i| i.status == "completed" }, due: @due.size, weekly: @minutes}.each do |key, value| %><article class="learning-panel"><span><%= t("learning.#{key}") %></span><strong><%= value %></strong></article><% end %>
</section>
<section class="learning-panel learning-next"><h2><%= t("learning.next") %></h2><p><%= t("learning.next_hint") %></p><% if @next %><h3><%= link_to @next.display_title, learning_item_path(@next) %></h3><span><%= @next.estimated_minutes %> <%= t("learning.minute") %> · <%= t("learning.statuses.#{@next.status}") %></span><% else %><p><%= t("learning.caught_up") %></p><% end %></section>
<% if @all.empty? %><section class="learning-panel"><h2><%= t("learning.empty") %></h2><p><%= t("learning.empty_hint") %></p><%= button_to t("learning.starter"), learning_items_path, params: {starter: "1"}, class: "btn btn-primary" %></section><% end %>
<%= form_with url: learning_root_path, method: :get, class: "learning-filters" do |f| %>
<div><%= f.label :q, t("learning.search") %><%= f.search_field :q, value: params[:q] %></div>
<% {track: Learning::Item::TRACKS, status: Learning::Item::STATUSES}.each do |field, values| %><div><%= f.label field, t("learning.fields.#{field}") %><%= f.select field, values.map { |value| [t("learning.#{field == :track ? 'tracks' : 'statuses'}.#{value}"), value] }, {include_blank: t("learning.all"), selected: params[field]} %></div><% end %><%= f.submit t("learning.filter"), class: "btn btn-secondary" %><% end %>
<section class="learning-grid"><% @items.each do |item| %><article class="learning-panel"><div class="learning-meta"><span><%= t("learning.tracks.#{item.track}") %></span><span><%= t("learning.statuses.#{item.status}") %></span></div><h2><%= link_to item.display_title, learning_item_path(item) %></h2><p><%= t("learning.kinds.#{item.kind}") %> · <%= item.estimated_minutes %> <%= t("learning.minute") %></p><label for="confidence-<%= item.id %>"><%= t("learning.fields.confidence") %>: <%= item.confidence %></label><progress id="confidence-<%= item.id %>" value="<%= item.confidence %>" max="5"><%= item.confidence %>/5</progress><% if item.target_on %><p><%= t("learning.fields.target_on") %>: <%= l(item.target_on) %></p><% end %><% if item.review_on %><p><%= t("learning.fields.review_on") %>: <%= l(item.review_on) %></p><% end %></article><% end %></section>
<% if @items.empty? && @all.any? %><p><%= t("learning.no_results") %></p><% end %>
<section class="learning-panel"><h2><%= t("learning.tips") %></h2><p><%= t("learning.tip_text") %></p><p><%= t("learning.ai_hint") %></p><%= link_to t("learning.export"), learning_export_path, class: "btn btn-secondary" %></section></div>
