{
  "name": "md-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Paperling-derived Markdown editor+preview bundle for the Rails dashboard (web adapter, no Tauri).",
  "scripts": {
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
