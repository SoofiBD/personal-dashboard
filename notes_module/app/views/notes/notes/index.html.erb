<main id="main-content" class="page-content notes-page">
  <header class="page-header notes-page-header"><div><p class="eyebrow">BİLGİ ALANI</p><h1>Notlar</h1><p>Markdown notlarınızı arayın, etiketleyin ve birbirine bağlayın.</p></div><div class="notes-header-actions"><%= link_to "Grafiği aç", graph_notes_notes_path, class: "btn btn-secondary" %><% if current_user.can_manage_notes? %><%= link_to new_notes_note_path, class: "btn btn-primary notes-new-button" do %><%= finance_svg_icon("plus", class: "button-icon", aria: {hidden: true}) %> Yeni not<% end %><% end %></div></header>
  <section class="notes-search-panel panel" aria-label="Not arama ve filtreleme"><%= form_with url: notes_root_path, method: :get, class: "notes-search-form" do |form| %><label for="notes-search">Notlarda ara</label><div class="notes-search-row"><%= form.search_field :q, id: "notes-search", value: @query, placeholder: "Başlık, içerik veya etiket ara", autocomplete: "off" %><% if @tag.present? %><%= hidden_field_tag :tag, @tag %><% end %><%= form.submit "Ara", class: "btn btn-secondary" %></div><% end %><% if @tags.any? %><nav class="notes-tags" aria-label="Etiket filtreleri"><%= link_to "Tümü", notes_root_path(q: @query.presence), class: "notes-tag #{'is-active' if @tag.blank?}" %><% @tags.each do |tag, count| %><%= link_to notes_root_path(tag: tag, q: @query.presence), class: "notes-tag #{'is-active' if @tag == tag}" do %><span>#<%= tag %></span><small><%= count %></small><% end %><% end %></nav><% end %></section>
  <section class="notes-grid" aria-label="Not listesi"><% if @notes.any? %><% @notes.each do |note| %><article class="notes-card panel <%= 'is-pinned' if note.pinned? %>"><div class="notes-card-heading"><h2><%= link_to note.title, notes_note_path(note) %></h2><% if note.pinned? %><span class="notes-status">Sabit</span><% end %></div><p class="notes-excerpt"><%= truncate(note.body.to_s.gsub(/[#*_`\[\]]/, " ").squish, length: 190, omission: "…") %></p><div class="notes-card-footer"><div class="notes-card-tags"><% note.tags.first(4).each { |tag| concat content_tag(:span, "##{tag}") } %></div><time datetime="<%= note.updated_at.iso8601 %>"><%= l(note.updated_at, format: :short) %></time></div></article><% end %><% else %><section class="notes-empty panel"><%= finance_svg_icon("notes", class: "notes-empty-icon", aria: {hidden: true}) %><h2><%= @query.present? || @tag.present? ? "Eşleşen not bulunamadı" : "İlk notunuzu oluşturun" %></h2><p><%= @query.present? || @tag.present? ? "Arama ifadenizi veya etiket filtrenizi değiştirin." : "Fikirlerinizi, planlarınızı ve referanslarınızı tek bir kişisel bilgi alanında tutun." %></p><% if current_user.can_manage_notes? && @query.blank? && @tag.blank? %><%= link_to "Yeni not", new_notes_note_path, class: "btn btn-primary" %><% end %></section><% end %></section>
</main>
