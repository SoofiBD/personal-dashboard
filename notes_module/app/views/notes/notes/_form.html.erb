<%= form_with model: @note, scope: :note, url: @note.persisted? ? notes_note_path(@note) : notes_notes_path, class: "notes-editor-form" do |form| %>
  <% if @note.errors.any? %><section class="flash flash-alert" role="alert"><p><%= @note.errors.full_messages.to_sentence %></p></section><% end %>
  <div class="notes-editor-topline"><div class="field-group notes-title-field"><%= form.label :title, "Başlık" %><%= form.text_field :title, autofocus: true, required: true, maxlength: 160, placeholder: "Notunuza kısa bir başlık verin" %></div><label class="notes-pin-control"><%= form.check_box :pinned %><span>Sabitle</span></label></div>
  <div class="field-group"><%= form.label :tag_list, "Etiketler" %><%= form.text_field :tag_list, value: @note.tag_list, placeholder: "ör. finans, fikirler, araştırma", autocomplete: "off" %><p class="field-hint">Virgülle ayırın. Etiketler arama ve filtreleme için kullanılır.</p></div>
  <div class="notes-editor-toolbar" aria-label="Markdown araçları"><button type="button" data-notes-wrap="**" data-notes-suffix="**"><strong>Kalın</strong></button><button type="button" data-notes-wrap="*" data-notes-suffix="*"><em>İtalik</em></button><button type="button" data-notes-prefix="## ">Başlık</button><button type="button" data-notes-wrap="[[" data-notes-suffix="]]">Not bağlantısı</button></div>
  <div class="field-group"><%= form.label :body, "İçerik (Markdown)" %><%= form.text_area :body, rows: 18, class: "notes-body-input", data: {notes_editor: true}, placeholder: "# Başlık\n\nDüşüncelerinizi yazın…\n\nBaşka bir nota [[Not Başlığı]] ile bağlanın." %><p class="field-hint">Mevcut bir notun başlığını <code>[[çift köşeli parantez]]</code> içinde yazarsanız iki not arasında bağlantı kurulur.</p></div>
  <div class="form-actions notes-form-actions"><%= link_to "Vazgeç", @note.persisted? ? notes_note_path(@note) : notes_root_path, class: "btn btn-secondary" %><%= form.submit @note.persisted? ? "Değişiklikleri kaydet" : "Notu kaydet", class: "btn btn-primary" %></div>
<% end %>
